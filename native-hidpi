def build_parser():
    epilog = """examples:
  native-hidpi status                                  show modes, scales and warnings
  native-hidpi fix                                     switch to native mode and pick a scale
  native-hidpi fix --dry-run                           show the plan without changing anything
  native-hidpi fix --scale 1.5                         force one framebuffer scale everywhere
  native-hidpi fix --scale DP-2=1.5 --scale DP-3=1.2   set a scale per output
  native-hidpi fix --no-display                        fonts only, leave the display alone
  native-hidpi fix --profile sharp                     choose the antialiasing profile
  native-hidpi revert                                  restore the recorded configuration

Works on GNOME (Mutter) and Hyprland."""
    p = argparse.ArgumentParser(description=__doc__, epilog=epilog,
                                formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = p.add_subparsers(dest="cmd")
    subs = {}

    subs["status"] = sub.add_parser(
        "status", help="report active vs native mode and scale",
        description="Report each output's active and native mode, scale and stored state.")

    fix_epilog = """examples:
  native-hidpi fix --dry-run                         show the plan without changing anything
  native-hidpi fix --scale 1.5                       force one framebuffer scale everywhere
  native-hidpi fix --scale DP-2=1.5 --scale DP-3=1.2 set a scale per output
  native-hidpi fix --no-display                      fonts only, leave the display alone
  native-hidpi fix --profile sharp                   choose the antialiasing profile"""
    f = sub.add_parser(
        "fix", help="switch to native mode with an integer scale",
        description="Switch outputs to their native mode and set framebuffer scales.",
        epilog=fix_epilog, formatter_class=argparse.RawDescriptionHelpFormatter)
    f.add_argument("--scale", action="append", metavar="NUMBER|CONNECTOR=NUMBER",
                   help="force a framebuffer scale: a bare NUMBER applies to every output, "
                        "CONNECTOR=NUMBER to one output (repeatable); shorthand such as 1.67 "
                        "snaps to the mode's 5/3 step, and a scale the mode does not offer "
                        "is refused, not faked with text scaling")
    f.add_argument("--text-scale", type=float, metavar="NUMBER",
                   help="set text-scaling-factor (e.g. 0.9); this only resizes GNOME text, "
                        "not windows, Chrome or Electron")
    f.add_argument("--want-logical-width", type=int, default=1920, metavar="PIXELS",
                   help="keep at least this many logical pixels wide when picking an "
                        "integer scale (default 1920)")
    f.add_argument("--profile", choices=sorted(PROFILES), default="mac",
                   help="antialiasing profile to install (default: mac)")
    f.add_argument("--no-fonts", action="store_true", help="only touch the display config")
    f.add_argument("--no-display", action="store_true",
                   help="only touch fonts (fontconfig, GSettings, stem darkening); leave "
                        "modes, scales and layout as they are")
    f.add_argument("--dry-run", action="store_true", help="print what would change")
    subs["fix"] = f

    subs["revert"] = sub.add_parser(
        "revert", help="restore the recorded mode, scale, gsettings and fonts.conf",
        description="Restore the mode, scale, gsettings and fonts.conf recorded by fix.")
    subs["selftest"] = sub.add_parser(
        "selftest", help="check the decision logic without touching the display",
        description="Check the decision logic with synthetic states; touches no display.")
    subs["help"] = sub.add_parser(
        "help", help="show help for a subcommand",
        description="Show top-level help, or help for one subcommand.")
    subs["help"].add_argument("name", nargs="?", choices=sorted(subs),
                              help="subcommand to explain (default: the general help)")
    return p, subs


def main():
    p, subs = build_parser()
    args = p.parse_args()
    if args.cmd is None or args.cmd == "help":
        if args.cmd == "help" and args.name:
            subs[args.name].print_help()
        else:
            p.print_help()
        return 0
    return {"status": cmd_status, "fix": cmd_fix, "revert": cmd_revert,
            "selftest": cmd_selftest}[args.cmd](args)


if __name__ == "__main__":
    sys.exit(main())
