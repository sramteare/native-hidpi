#!/usr/bin/env python3
"""Check that a GNOME session drives a monitor at its native resolution, and switch
to native mode with an integer framebuffer scale.

The common failure this addresses: a 4K panel fed a 1440p signal. The monitor's own
scaler upsamples every pixel by a non-integer factor, so the whole desktop looks soft.
No font, fontconfig or antialiasing setting can recover that, and nothing reports it -
the resolution just "looks a bit blurry".
"""

import argparse
import json
import os
import shutil
import subprocess
import sys

try:
    import gi
    gi.require_version("Gio", "2.0")
    from gi.repository import Gio, GLib
except ImportError:
    sys.exit("python3-gi is required:  sudo apt install python3-gi")

DEST = "org.gnome.Mutter.DisplayConfig"
PATH = "/org/gnome/Mutter/DisplayConfig"
IFACE = "org.gnome.Mutter.DisplayConfig"
STATE_SIG = "(ua((ssss)a(siiddada{sv})a{sv})a(iiduba(ssss)a{sv})a{sv})"
APPLY_SIG = "(uua(iiduba(ssa{sv}))a{sv})"

# Mutter's method flags are documented inconsistently across versions (verify/persist
# as bitflags in some, verify/temporary/persistent in others), so this tool applies
# exactly one configuration and checks the result by reading it back, rather than
# trusting a separate verify step.
METHOD_PERSIST = 2

STATE_DIR = os.path.join(
    os.environ.get("XDG_STATE_HOME", os.path.expanduser("~/.local/state")), "native-hidpi"
)
STATE_FILE = os.path.join(STATE_DIR, "state.json")
FONTCONF = os.path.join(
    os.environ.get("XDG_CONFIG_HOME", os.path.expanduser("~/.config")),
    "fontconfig",
    "fonts.conf",
)
FONTCONF_BACKUP = FONTCONF + ".native-hidpi.bak"

UI_FONT_KEYS = [
    "font-name",
    "monospace-font-name",
    "document-font-name",
    "font-antialiasing",
    "font-hinting",
    "font-rendering",
    "text-scaling-factor",
]

# fontconfig rgba/hintstyle, gnome antialiasing/hinting
PROFILES = {
    "mac": ("none", "hintslight", "grayscale", "slight"),
    "sharp": ("none", "hintfull", "grayscale", "full"),
    "subpixel": ("rgb", "hintslight", "rgba", "slight"),
}


def bus_call(method, inb=None, outt=None):
    bus = Gio.bus_get_sync(Gio.BusType.SESSION, None)
    return bus.call_sync(
        DEST, PATH, IFACE, method, inb,
        GLib.VariantType.new(outt) if outt else None,
        Gio.DBusCallFlags.NONE, -1, None,
    )


def have_display_config():
    try:
        bus_call("GetCurrentState", None, STATE_SIG)
        return True
    except GLib.Error:
        return False


def session_type():
    return os.environ.get("XDG_SESSION_TYPE", "unknown")


def read_state():
    """(serial, logical_monitors). A logical monitor may mirror several connectors."""
    serial, monitors, logical, props = bus_call("GetCurrentState", None, STATE_SIG)
    out = []
    for lm in logical:
        x, y, scale, transform, primary, members, _ = lm
        connectors = [m[0] for m in members]
        specs = [(m[0], m[3]) for m in members]
        native = current = None
        scales = []
        builtin = False
        for mon in monitors:
            if mon[0][0] not in connectors:
                continue
            builtin = builtin or bool(mon[2].get("is-builtin", False))
            for mode in mon[1]:
                mode_id, w, h, rate, _max, supported, mode_props = mode
                if "is-current" in mode_props:
                    current = (mode_id, w, h, rate)
                    scales = list(supported)
                if "is-preferred" in mode_props:
                    native = (mode_id, w, h, rate)
        out.append(
            {
                "connectors": connectors,
                "specs": specs,
                "identity": tuple(sorted(specs)),
                "x": x,
                "y": y,
                "scale": float(scale),
                "transform": transform,
                "primary": primary,
                "current": current,
                "native": native,
                "scales": scales,
                "builtin": builtin,
            }
        )
    return int(serial), out


def best_integer_scale(native, scales, want_logical_width=1920):
    """Largest integer scale that the mode actually offers and whose logical width
    still fits the wanted desktop. Falls back to the largest supported scale."""
    if native is None:
        return 1.0
    offered = [float(s) for s in scales]
    candidates = []
    for s in (4, 3, 2, 1):
        if native[1] // s < want_logical_width:
            continue
        if not offered or float(s) in offered:
            candidates.append(float(s))
    if candidates:
        return max(candidates)
    return max(offered) if offered else 1.0


def build_apply_list(states, changes):
    """The logical_monitors array is the complete desired configuration: anything left
    out is disabled. Always send every output, changing only what was asked for."""
    lm = []
    for i, s in enumerate(states):
        mode_id, scale = changes.get(i, (s["current"][0] if s["current"] else None, s["scale"]))
        if mode_id is None:
            raise RuntimeError(f"{s['connectors']}: no current mode, refusing to apply")
        lm.append((s["x"], s["y"], float(scale), s["transform"], s["primary"],
                   [(conn, mode_id, {}) for conn in s["connectors"]]))
    return lm


def apply_changes(states, changes, dry=False):
    if dry:
        return
    serial, fresh = read_state()
    if len(fresh) != len(states):
        raise RuntimeError(
            f"output count changed between reading and applying "
            f"({len(states)} -> {len(fresh)}); nothing applied, re-run"
        )
    for i, s in enumerate(fresh):
        if sorted(s["connectors"]) != sorted(states[i]["connectors"]):
            raise RuntimeError(f"output set changed (hotplug?); nothing applied, re-run")
    args = GLib.Variant(APPLY_SIG, (serial, METHOD_PERSIST, build_apply_list(fresh, changes), {}))
    bus_call("ApplyMonitorsConfig", args)


def verify_applied(changes, retries=1):
    """Read the configuration back. This, not a verify flag, is the safety net."""
    for _ in range(retries + 1):
        _serial, states = read_state()
        bad = []
        for i, (mode_id, scale) in changes.items():
            if i >= len(states):
                bad.append(f"output {i} missing")
                continue
            s = states[i]
            if s["current"] is None or s["current"][0] != mode_id or abs(s["scale"] - scale) > 1e-6:
                got = s["current"][0] if s["current"] else "none"
                bad.append(f"{','.join(s['connectors'])}: wanted {mode_id} scale {scale}, got {got} scale {s['scale']}")
        if not bad:
            return True, []
    return False, bad


def resolution_problem(cur, native):
    return bool(cur and native and (cur[1], cur[2]) != (native[1], native[2]))


def find_problems(states):
    """Non-native resolution on a panel, i.e. the monitor's scaler is in the path."""
    msgs = []
    for m in states:
        cur, native = m["current"], m["native"]
        if resolution_problem(cur, native):
            ratio = native[1] / cur[1]
            msgs.append(
                f"{','.join(m['connectors'])}: {cur[1]}x{cur[2]} signal on a "
                f"{native[1]}x{native[2]} panel, monitor upscales x{ratio:.2f}"
                + (" (built-in panel)" if m.get("builtin") else "")
            )
    return msgs


def find_notes(states):
    msgs = []
    for m in states:
        if not float(m["scale"]).is_integer():
            msgs.append(
                f"{','.join(m['connectors'])}: fractional scale {m['scale']} - clients that "
                "do not implement fractional-scale-v1 render at the next integer scale and "
                "get resampled, and apps that ignore scaling end up a different size than "
                "their neighbours"
            )
    return msgs


def report(states):
    for m in states:
        cur, native = m["current"], m["native"]
        label = ",".join(m["connectors"]) + (" [built-in]" if m["builtin"] else "")
        print(f"\n{label}  scale {m['scale']}  primary={m['primary']}")
        if cur is None:
            print("  no current mode reported")
            continue
        print(f"  active : {cur[0]}")
        print(f"  native : {native[0] if native else 'unknown'}")
        print(f"  scales supported on the active mode: "
              f"{', '.join(str(s) for s in m['scales']) if m['scales'] else 'unknown'}")
    problems = find_problems(states)
    for p in problems:
        print("\nWARNING  " + p +
              ". Everything on screen is soft and no font setting will fix it.")
    for n in find_notes(states):
        print("\nNOTE     " + n)
    return len(problems)


def gsettings_get(key):
    if not shutil.which("gsettings"):
        return None
    r = subprocess.run(
        ["gsettings", "get", "org.gnome.desktop.interface", key],
        capture_output=True, text=True,
    )
    return r.stdout.strip() if r.returncode == 0 else None


def gsettings_op(op, key, value=None):
    if not shutil.which("gsettings"):
        return False
    argv = ["gsettings", op, "org.gnome.desktop.interface", key]
    if op == "set":
        argv.append(value)
    return subprocess.run(argv, capture_output=True).returncode == 0


def fontconf_body(rgba, hintstyle):
    return f"""<?xml version="1.0"?>
<!DOCTYPE fontconfig SYSTEM "fonts.dtd">
<!-- written by native-hidpi -->
<fontconfig>
  <match target="font">
    <edit name="antialias" mode="assign"><bool>true</bool></edit>
    <edit name="rgba" mode="assign"><const>{rgba}</const></edit>
    <edit name="hinting" mode="assign"><bool>true</bool></edit>
    <edit name="hintstyle" mode="assign"><const>{hintstyle}</const></edit>
    <edit name="hintauto" mode="assign"><bool>false</bool></edit>
    <edit name="embeddedbitmap" mode="assign"><bool>false</bool></edit>
  </match>
</fontconfig>
"""


def fontconf_ok(path):
    """fontconfig drops the *entire* file on a single parse error and every client
    silently falls back to distro defaults. fontconfig always names the offending file
    in its message, so only attribute errors that mention ours."""
    if not shutil.which("fc-match"):
        return True, ""
    err = subprocess.run(["fc-match", "sans-serif"], capture_output=True, text=True).stderr
    return (os.path.basename(path) not in err and path not in err), err.strip()


def write_fontconf(rgba, hintstyle):
    import xml.etree.ElementTree as ET
    body = fontconf_body(rgba, hintstyle)
    try:
        ET.fromstring(body)
    except ET.ParseError as exc:
        sys.exit(f"refusing to write malformed fonts.conf: {exc}")
    if os.path.exists(FONTCONF) and not os.path.exists(FONTCONF_BACKUP):
        shutil.copy2(FONTCONF, FONTCONF_BACKUP)
    try:
        os.makedirs(os.path.dirname(FONTCONF), exist_ok=True)
        tmp = FONTCONF + ".tmp"
        with open(tmp, "w") as fh:
            fh.write(body)
        os.replace(tmp, FONTCONF)
    except OSError as exc:
        sys.exit(f"cannot write {FONTCONF}: {exc}")
    ok, err = fontconf_ok(FONTCONF)
    if not ok:
        if os.path.exists(FONTCONF_BACKUP):
            shutil.copy2(FONTCONF_BACKUP, FONTCONF)
        else:
            os.remove(FONTCONF)
        sys.exit(f"fontconfig rejected {FONTCONF}; previous file restored.\n{err}")
    return True


def save_state(data):
    try:
        os.makedirs(STATE_DIR, exist_ok=True)
        tmp = STATE_FILE + ".tmp"
        with open(tmp, "w") as fh:
            json.dump(data, fh, indent=2)
        os.replace(tmp, STATE_FILE)
    except OSError as exc:
        sys.exit(f"cannot record previous state in {STATE_FILE}: {exc} (nothing applied)")


def load_state():
    if not os.path.exists(STATE_FILE):
        return {}
    try:
        with open(STATE_FILE) as fh:
            return json.load(fh)
    except (OSError, json.JSONDecodeError) as exc:
        print(f"{STATE_FILE} is unreadable ({exc}); keeping it aside and starting fresh")
        try:
            os.replace(STATE_FILE, STATE_FILE + ".corrupt")
        except OSError:
            pass
        return {}


MONITORS_XML = os.path.join(
    os.environ.get("XDG_CONFIG_HOME", os.path.expanduser("~/.config")), "monitors.xml"
)
MONITORS_XML_BACKUP = MONITORS_XML + ".native-hidpi.bak"


def read_monitors_xml():
    """Return the stored configurations as a list of dicts, or [] if there is no file.
    Raises ValueError if the file cannot be parsed."""
    if not os.path.exists(MONITORS_XML):
        return []
    import xml.etree.ElementTree as ET
    try:
        root = ET.parse(MONITORS_XML).getroot()
    except ET.ParseError as exc:
        raise ValueError(f"{MONITORS_XML}: {exc}")
    out = []
    for cfg in root.findall("configuration"):
        monitors = []
        for lm in cfg.findall("logicalmonitor"):
            spec = lm.find("monitor/monitorspec")
            mode = lm.find("monitor/mode")
            scale = lm.find("scale")
            if spec is None or mode is None:
                continue
            monitors.append({
                "element": lm,
                "connector": spec.findtext("connector"),
                "product": spec.findtext("product"),
                "serial": spec.findtext("serial") or "",
                "mode": (int(mode.findtext("width")), int(mode.findtext("height")),
                         float(mode.findtext("rate"))),
                "scale": float(scale.text) if scale is not None and scale.text else 1.0,
            })
        if monitors:
            out.append({"element": cfg, "monitors": monitors})
    return out


def persist_monitors_xml(states, changes):
    """Mutter's persistent apply does not reliably rewrite ~/.config/monitors.xml, and
    whatever is in that file is what you get back after a hotplug or a login. So write
    it ourselves: update the stored block that matches the current outputs, or append a
    new one."""
    import xml.etree.ElementTree as ET

    if os.path.exists(MONITORS_XML) and not os.path.exists(MONITORS_XML_BACKUP):
        try:
            shutil.copy2(MONITORS_XML, MONITORS_XML_BACKUP)
        except OSError as exc:
            return f"could not back up {MONITORS_XML}: {exc}"

    try:
        root = ET.parse(MONITORS_XML).getroot() if os.path.exists(MONITORS_XML) else \
            ET.Element("monitors", {"version": "2"})
    except ET.ParseError:
        return f"{MONITORS_XML} is malformed; refusing to edit it"

    want = {}
    for i, s in enumerate(states):
        s.setdefault("identity", tuple(sorted((c, "") for c in s["connectors"])))
        mode_id, scale = changes.get(i, (s["current"][0] if s["current"] else None, s["scale"]))
        if mode_id is None:
            continue
        w, h = s["native"][1], s["native"][2]
        rate = s["native"][3]
        want[s["identity"]] = (w, h, rate, float(scale), s["primary"])

    updated = 0
    for cfg in root.findall("configuration"):
        block_id = tuple(sorted(
            (l.findtext("monitor/monitorspec/connector"),
             l.findtext("monitor/monitorspec/serial") or "")
            for l in cfg.findall("logicalmonitor")
        ))
        if block_id not in want:
            continue
        for lm in cfg.findall("logicalmonitor"):
            key = ((lm.findtext("monitor/monitorspec/connector"),
                    lm.findtext("monitor/monitorspec/serial") or ""),)
            i = next((k for k in want if set(k) == set(key)), None)
            if i is None:
                continue
            w, h, rate, scale, _prim = want[i]
            mode = lm.find("monitor/mode")
            for tag, value in (("width", str(w)), ("height", str(h)), ("rate", f"{rate:.3f}")):
                node = mode.find(tag)
                if node is None:
                    node = ET.SubElement(mode, tag)
                node.text = value
            scale_node = lm.find("scale")
            if scale_node is None:
                scale_node = ET.SubElement(lm, "scale")
            scale_node.text = f"{scale:g}"
        updated += 1

    if not updated:
        cfg = ET.SubElement(root, "configuration")
        ET.SubElement(cfg, "layoutmode").text = "logical"
        for conns, (w, h, rate, scale, primary) in want.items():
            for conn, _serial in conns:
                lm = ET.SubElement(cfg, "logicalmonitor")
                for tag in ("x", "y"):
                    ET.SubElement(lm, tag).text = "0"
                if primary:
                    ET.SubElement(lm, "primary").text = "yes"
                scale_node = ET.SubElement(lm, "scale")
                scale_node.text = f"{scale:g}"
                mon = ET.SubElement(lm, "monitor")
                spec = ET.SubElement(mon, "monitorspec")
                for tag in ("connector", "vendor", "product", "serial"):
                    ET.SubElement(spec, tag).text = ""
                spec.find("connector").text = conn
                spec.find("serial").text = _serial
                mode = ET.SubElement(mon, "mode")
                for tag, value in (("width", str(w)), ("height", str(h)), ("rate", f"{rate:.3f}")):
                    ET.SubElement(mode, tag).text = value

    try:
        tmp = MONITORS_XML + ".tmp"
        ET.ElementTree(root).write(tmp, encoding="unicode", xml_declaration=False)
        ET.parse(tmp)  # never leave a broken config behind
        os.replace(tmp, MONITORS_XML)
    except (OSError, ET.ParseError) as exc:
        try:
            os.remove(MONITORS_XML + ".tmp")
        except OSError:
            pass
        return f"could not persist {MONITORS_XML}: {exc}"
    return None


def stored_vs_running(states):
    """Catch the case that eats users' crispness silently: the stored config disagrees
    with what is running, so the next hotplug or login will undo a live change."""
    notes = []
    try:
        stored = read_monitors_xml()
    except ValueError as exc:
        return [str(exc)]
    for cfg in stored:
        conns = tuple(sorted(m["connector"] for m in cfg["monitors"]))
        block_id = tuple(sorted((m["connector"], m["serial"]) for m in cfg["monitors"]))
        for s in states:
            if s.get("identity", tuple(sorted((c, "") for c in s["connectors"]))) != block_id \
                    or s["current"] is None:
                continue
            for m in cfg["monitors"]:
                if (m["mode"][0], m["mode"][1]) != (s["current"][1], s["current"][2]) or \
                        abs(m["scale"] - s["scale"]) > 1e-6:
                    notes.append(
                        f"{','.join(conns)}: running {s['current'][1]}x{s['current'][2]} "
                        f"scale {s['scale']} but {MONITORS_XML} stores "
                        f"{m['mode'][0]}x{m['mode'][1]} scale {m['scale']} - the next "
                        "hotplug or login will switch it back"
                    )
    return notes


def need_display():
    if not have_display_config():
        sys.exit(
            f"org.gnome.Mutter.DisplayConfig is not available (session type: "
            f"{session_type()}). This tool needs a GNOME session running Mutter."
        )


def cmd_status(_args):
    need_display()
    _serial, states = read_state()
    if not states:
        sys.exit(
            "no logical monitors reported by Mutter - no display connected, or the "
            "session is headless. Re-run with a monitor attached."
        )
    problems = report(states)
    font = gsettings_get("font-name")
    if font is not None:
        try:
            pt = float(font.strip("'").rsplit(" ", 1)[1])
            px_em = pt / 72 * 96 * states[0]["scale"]
            print(f"\nUI font  {font.strip()}  -> {px_em:.1f} device px per em "
                  f"at scale {states[0]['scale']}")
            print(f"antialiasing {gsettings_get('font-antialiasing')}   "
                  f"hinting {gsettings_get('font-hinting')}")
        except (ValueError, IndexError):
            pass
    broken = 0
    if os.path.exists(FONTCONF):
        ok, err = fontconf_ok(FONTCONF)
        if ok:
            print(f"\nuser fontconfig: {FONTCONF} loads ok")
        else:
            broken = 1
            print(f"\nWARNING  {FONTCONF} is malformed, so fontconfig has dropped it "
                  "entirely: Chrome, Electron and Java clients are silently back on "
                  "distro defaults.")
            print(f"  {err}")
    for note in stored_vs_running(states):
        print("\nNOTE     " + note)
    print("\n" + ("no non-native resolution detected" if problems == 0 else
                  f"{problems} monitor(s) not running at native resolution"))
    return 0 if (problems == 0 and broken == 0) else 1


def plan_fix(states, forced_scale, want_logical_width):
    changes, skipped = {}, []
    for i, m in enumerate(states):
        if m["current"] is None:
            continue
        if m["native"] is None:
            skipped.append(",".join(m["connectors"]))
            continue
        scale = forced_scale or best_integer_scale(m["native"], m["scales"], want_logical_width)
        needs_mode = resolution_problem(m["current"], m["native"])
        needs_scale = abs(m["scale"] - scale) > 1e-6
        if needs_mode or needs_scale:
            changes[i] = (m["native"][0], float(scale))
    return changes, skipped


def cmd_fix(args):
    need_display()
    _serial, states = read_state()
    if not states:
        sys.exit(
            "no logical monitors reported by Mutter - no display connected, or the "
            "session is headless. Re-run with a monitor attached."
        )
    changes, skipped = plan_fix(states, args.scale, args.want_logical_width)

    if not changes:
        print("every output is already at native resolution with the chosen scale")
        if skipped:
            print(f"  (no native mode reported for: {', '.join(skipped)} - left alone)")
    else:
        for i, (mode_id, scale) in changes.items():
            m = states[i]
            print(f"planned {','.join(m['connectors'])}: "
                  f"{m['current'][0]} scale {m['scale']} -> {mode_id} scale {scale}")
        print(f"(untouched outputs: {len(states) - len(changes)})")

    if args.dry_run:
        print(f"would persist to {MONITORS_XML} (backup {MONITORS_XML_BACKUP})")
        if not args.no_fonts:
            rgba, hintstyle, _ga, _gh = PROFILES[args.profile]
            print(f"would write {FONTCONF} (rgba={rgba}, hintstyle={hintstyle})")
        return 0

    if changes:
        prev = load_state()
        if "display" not in prev:
            prev["display"] = [
                {"connectors": s["connectors"], "mode": s["current"][0], "scale": s["scale"]}
                for s in states if s["current"]
            ]
            save_state(prev)
        try:
            apply_changes(states, changes)
        except (GLib.Error, RuntimeError) as exc:
            sys.exit(f"apply failed, nothing changed: {exc}")
        ok, bad = verify_applied(changes)
        if not ok:
            baseline = {
                i: (s["current"][0], s["scale"])
                for i, s in enumerate(states) if s["current"]
            }
            rolled = False
            try:
                apply_changes(states, baseline)
                rolled, _ = verify_applied(baseline)
            except (GLib.Error, RuntimeError) as exc:
                print(f"rollback failed too: {exc}")
            for line in bad:
                print("  " + line)
            sys.exit("the requested configuration did not take effect; "
                     + ("rolled back to the previous one." if rolled else
                        "ROLL IT BACK YOURSELF: Settings -> Displays"))
        for i, (mode_id, scale) in changes.items():
            print(f"applied {','.join(states[i]['connectors'])}: {mode_id} scale {scale} "
                  "(read back and confirmed)")
        err = persist_monitors_xml(states, changes)
        if err:
            print(f"WARNING  {err}")
            print("  the live change is in effect, but the next hotplug or login will undo it")
        else:
            print(f"persisted to {MONITORS_XML} (backup at {MONITORS_XML_BACKUP})")

    if not args.no_fonts:
        rgba, hintstyle, gnome_aa, gnome_hint = PROFILES[args.profile]
        if args.dry_run:
            print(f"would write {FONTCONF} (rgba={rgba}, hintstyle={hintstyle})")
            return 0
        prev = load_state()
        if "interface" not in prev:
            prev["interface"] = {k: gsettings_get(k) for k in UI_FONT_KEYS}
        if os.path.exists(FONTCONF) and "fontconf" not in prev:
            with open(FONTCONF) as fh:
                prev["fontconf"] = fh.read()
        save_state(prev)
        write_fontconf(rgba, hintstyle)
        gsettings_op("set", "font-rendering", "manual")
        gsettings_op("set", "font-antialiasing", gnome_aa)
        gsettings_op("set", "font-hinting", gnome_hint)
        print(f"wrote {FONTCONF} and set antialiasing={gnome_aa}, hinting={gnome_hint}")
        print("profiles: mac (grayscale+slight), sharp (grayscale+full), subpixel (rgb+slight)")
        print("restart browsers - they read fontconfig once at startup")
    return 0


def cmd_revert(_args):
    prev = load_state()
    if not prev:
        print("nothing recorded in " + STATE_FILE)
        return 1
    failed = []

    if prev.get("display") and have_display_config():
        _serial, states = read_state()
        changes = {}
        for saved in prev["display"]:
            want_specs = saved.get("specs")
            for i, s in enumerate(states):
                here = [tuple(c) for c in s.get("specs", [])]
                if want_specs:
                    matched = sorted(here) == sorted(tuple(c) for c in want_specs)
                else:  # state recorded before serials were tracked
                    matched = sorted(s["connectors"]) == sorted(saved["connectors"])
                if matched:
                    changes[i] = (saved["mode"], saved["scale"])
        if len(changes) != len(states):
            print("note: the connected output set no longer matches what was recorded; "
                  "restoring only the outputs that are present")
        try:
            apply_changes(states, changes)
            print("restored " + ", ".join(
                f"{','.join(s['connectors'])}={changes[i][0]}@{changes[i][1]}"
                for i, s in enumerate(states) if i in changes))
        except (GLib.Error, RuntimeError) as exc:
            failed.append("display")
            print(f"could not restore the display configuration: {exc}")

    if os.path.exists(MONITORS_XML_BACKUP):
        try:
            shutil.copy2(MONITORS_XML_BACKUP, MONITORS_XML)
            print(f"restored {MONITORS_XML} from {MONITORS_XML_BACKUP}")
        except OSError as exc:
            failed.append("monitors.xml")
            print(f"could not restore {MONITORS_XML}: {exc}")

    if prev.get("interface"):
        for key, value in prev["interface"].items():
            if value is None:
                if not gsettings_op("reset", key):
                    failed.append("gsettings")
            elif not gsettings_op("set", key, value.strip("'")):
                failed.append("gsettings")

    if "fontconf" in prev:
        try:
            if prev["fontconf"] is None:
                if os.path.exists(FONTCONF):
                    os.remove(FONTCONF)
                print(f"removed {FONTCONF} (there was none before)")
            else:
                tmp = FONTCONF + ".tmp"
                with open(tmp, "w") as fh:
                    fh.write(prev["fontconf"])
                os.replace(tmp, FONTCONF)
                print(f"restored {FONTCONF}")
        except OSError as exc:
            failed.append("fontconfig")
            print(f"could not restore {FONTCONF}: {exc}")

    if failed:
        print(f"\nnot reverted: {', '.join(sorted(set(failed)))}. Keeping {STATE_FILE} "
              "so you can try again.")
        return 1
    try:
        os.remove(STATE_FILE)
    except OSError:
        pass
    print("reverted; restart browsers")
    return 0


def cmd_selftest(_args):
    """Exercise the decision logic without touching the display."""
    fake = [
        {  # the bug this tool exists for: 1440p signal on a 4K panel
            "connectors": ["DP-1"], "x": 0, "y": 0, "scale": 1.0, "transform": 0,
            "primary": True, "current": ("2560x1440@59.951", 2560, 1440, 59.951),
            "native": ("3840x2160@59.997", 3840, 2160, 59.997),
            "scales": [1.0, 1.25, 1.5, 2.0], "builtin": False,
        },
        {  # correct: native mode, integer scale
            "connectors": ["DP-2"], "x": 1920, "y": 0, "scale": 2.0, "transform": 0,
            "primary": False, "current": ("3840x2160@59.997", 3840, 2160, 59.997),
            "native": ("3840x2160@59.997", 3840, 2160, 59.997),
            "scales": [1.0, 2.0], "builtin": False,
        },
    ]
    mirror = {  # a cloned pair is one logical monitor with two connectors
        "connectors": ["eDP-1", "DP-3"], "x": 0, "y": 0, "scale": 1.0, "transform": 1,
        "primary": True, "current": ("2880x1800@60", 2880, 1800, 60.0),
        "native": ("2880x1800@60", 2880, 1800, 60.0), "scales": [1.0, 2.0], "builtin": True,
    }
    stale = {  # native resolution but the panel's 60 Hz preferred mode is unused
        "connectors": ["DP-4"], "x": 0, "y": 0, "scale": 1.0, "transform": 0,
        "primary": False, "current": ("3840x2160@29.562", 3840, 2160, 29.562),
        "native": ("3840x2160@59.997", 3840, 2160, 59.997), "scales": [1.0, 2.0],
        "builtin": False,
    }
    # monitors.xml persistence, exercised against a scratch copy of the real format
    import tempfile
    global MONITORS_XML, MONITORS_XML_BACKUP
    _real_xml, _real_bak = MONITORS_XML, MONITORS_XML_BACKUP
    r = {}
    with tempfile.TemporaryDirectory() as td:
        MONITORS_XML = os.path.join(td, "monitors.xml")
        MONITORS_XML_BACKUP = MONITORS_XML + ".bak"
        with open(MONITORS_XML, "w") as fh:
            fh.write(
                '<monitors version="2">\n  <configuration>\n'
                '    <layoutmode>logical</layoutmode>\n    <logicalmonitor>\n'
                '      <x>0</x>\n      <y>0</y>\n      <scale>1.5</scale>\n'
                '      <primary>yes</primary>\n      <monitor>\n        <monitorspec>\n'
                '          <connector>DP-1</connector>\n          <vendor>DEL</vendor>\n'
                '          <product>DELL U2720Q</product>\n          <serial>X</serial>\n'
                '        </monitorspec>\n        <mode>\n          <width>3840</width>\n'
                '          <height>2160</height>\n          <rate>59.997</rate>\n'
                '        </mode>\n      </monitor>\n    </logicalmonitor>\n'
                '  </configuration>\n</monitors>\n')
        running = dict(fake[0], current=("3840x2160@59.997", 3840, 2160, 59.997), scale=1.5,
                       specs=[("DP-1", "X")], identity=(("DP-1", "X"),))
        parsed = read_monitors_xml()
        r["parsed"] = len(parsed) == 1 and parsed[0]["monitors"][0]["scale"] == 1.5
        r["match_ok"] = stored_vs_running([running]) == []
        r["stale_detected"] = len(stored_vs_running([dict(running, scale=2.0)])) == 1
        err = persist_monitors_xml([running], {0: ("3840x2160@59.997", 2.0)})
        r["persist_ok"] = err is None
        r["backup_written"] = os.path.exists(MONITORS_XML_BACKUP)
        after = read_monitors_xml()
        r["scale_rewritten"] = bool(after) and after[0]["monitors"][0]["scale"] == 2.0
        r["stale_gone"] = stored_vs_running([dict(running, scale=2.0)]) == []
        other = persist_monitors_xml(
            [dict(fake[1], connectors=["DP-9"], specs=[("DP-9", "Y")],
                  identity=(("DP-9", "Y"),), primary=False)],
            {0: ("3840x2160@59.997", 2.0)})
        txt = open(MONITORS_XML).read()
        r["unknown_output_appended"] = other is None and "DP-9" in txt
        r["other_monitor_block_untouched"] = "<serial>X</serial>" in txt \
            and txt.count("<configuration>") == 2
        with open(MONITORS_XML, "w") as fh:
            fh.write("<monitors version='2'><configuration>")
        r["malformed_detected"] = False
        try:
            read_monitors_xml()
        except ValueError:
            r["malformed_detected"] = True
        r["malformed_not_edited"] = persist_monitors_xml(
            [running], {0: ("3840x2160@59.997", 2.0)}) is not None
    MONITORS_XML, MONITORS_XML_BACKUP = _real_xml, _real_bak

    checks = [
        ("detects upscaled signal", len(find_problems(fake)) == 1),
        ("names the right connector", find_problems(fake)[0].startswith("DP-1")),
        ("leaves native+2x alone", find_problems(fake[1:]) == []),
        ("ignores refresh-rate mismatch", find_problems([stale]) == []),
        ("flags fractional scale", find_notes([dict(fake[1], scale=1.5)]) != []),
        ("picks 2x on 4K", best_integer_scale(fake[0]["native"], [1.0, 2.0], 1920) == 2.0),
        ("picks 1x on 1440p panel", best_integer_scale((None, 2560, 1440, 60), [], 1920) == 1.0),
        ("honours wanted logical width",
         best_integer_scale(fake[0]["native"], [1.0, 1.5, 2.0], 2560) == 1.0),
        ("never returns an unoffered scale",
         best_integer_scale(fake[0]["native"], [1.0, 1.25, 1.5], 1920) in [1.0, 1.25, 1.5]),
        ("prefers pixel-exact integer when 2x is unavailable",
         best_integer_scale(fake[0]["native"], [1.0, 1.25, 1.5], 1920) == 1.0),
        ("plan leaves healthy output alone",
         plan_fix(fake, None, 1920)[0] == {0: ("3840x2160@59.997", 2.0)}),
        ("apply list keeps every output",
         len(build_apply_list(fake, {0: ("3840x2160@59.997", 2.0)})) == 2),
        ("untouched outputs keep their mode",
         build_apply_list(fake, {0: ("3840x2160@59.997", 2.0)})[1] ==
         (1920, 0, 2.0, 0, False, [("DP-2", "3840x2160@59.997", {})])),
        ("mirrored pair keeps both connectors",
         build_apply_list([mirror], {}) [0][5] ==
         [("eDP-1", "2880x1800@60", {}), ("DP-3", "2880x1800@60", {})]),
        ("built-in flagged in the warning", "built-in" in find_problems([
            dict(mirror, current=("1920x1200@60", 1920, 1200, 60.0))])[0]),
        ("stored monitors.xml parsed", r["parsed"]),
        ("running match produces no note", r["match_ok"]),
        ("stored-vs-running mismatch detected", r["stale_detected"]),
        ("persist reports success", r["persist_ok"]),
        ("persist backs up monitors.xml", r["backup_written"]),
        ("persist rewrites the stored scale", r["scale_rewritten"]),
        ("mismatch gone after persist", r["stale_gone"]),
        ("unmatched output gets a new block", r["unknown_output_appended"]),
        ("same connector, different serial: other block untouched",
         r["other_monitor_block_untouched"]),
        ("malformed monitors.xml detected", r["malformed_detected"]),
        ("malformed monitors.xml refused, not edited", r["malformed_not_edited"]),
        ("user fonts.conf parses (if present)",
         (not os.path.exists(FONTCONF)) or fontconf_ok(FONTCONF)[0]),
    ]
    failed = 0
    for name, ok in checks:
        print(f"  {'ok  ' if ok else 'FAIL'}  {name}")
        failed += 0 if ok else 1
    print("\nreport for the synthetic 1440p-on-4K case:")
    report(fake[:1])
    print()
    return 1 if failed else 0


def main():
    p = argparse.ArgumentParser(description=__doc__,
                                formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = p.add_subparsers(dest="cmd", required=True)

    sub.add_parser("status", help="report active vs native mode and scale")

    f = sub.add_parser("fix", help="switch to native mode with an integer scale")
    f.add_argument("--scale", type=float, help="force a framebuffer scale (e.g. 2)")
    f.add_argument("--want-logical-width", type=int, default=1920,
                   help="keep at least this many logical pixels wide when picking an "
                        "integer scale (default 1920)")
    f.add_argument("--profile", choices=sorted(PROFILES), default="mac",
                   help="antialiasing profile to install (default: mac)")
    f.add_argument("--no-fonts", action="store_true", help="only touch the display config")
    f.add_argument("--dry-run", action="store_true", help="print what would change")

    sub.add_parser("revert", help="restore the recorded mode, scale, gsettings and fonts.conf")
    sub.add_parser("selftest", help="check the decision logic without touching the display")

    args = p.parse_args()
    return {"status": cmd_status, "fix": cmd_fix, "revert": cmd_revert,
            "selftest": cmd_selftest}[args.cmd](args)


if __name__ == "__main__":
    sys.exit(main())
