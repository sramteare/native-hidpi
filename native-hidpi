    # the same panel on a cable that stops at 5/3: no integer step to fall back on
    no_int_panel = dict(frac_panel, connectors=["DP-8"],
                        native_scales=[1.0, 1.25, THIRDS, 1.5, FRAC])

    def cfg_xml(lms):
        return ('  <configuration>\n    <layoutmode>logical</layoutmode>\n' + lms
                + '  </configuration>\n')

    def doc(*cfgs):
        return '<monitors version="2">\n' + ''.join(cfgs) + '</monitors>\n'

    def mon_xml(conn, serial, vendor, product, w, h, rate):
        return (f'      <monitor>\n        <monitorspec>\n'
                f'          <connector>{conn}</connector>\n          <vendor>{vendor}</vendor>\n'
                f'          <product>{product}</product>\n          <serial>{serial}</serial>\n'
                f'        </monitorspec>\n        <mode>\n          <width>{w}</width>\n'
                f'          <height>{h}</height>\n          <rate>{rate}</rate>\n'
                f'        </mode>\n      </monitor>\n')

    def lm_xml(x, y, scale, monitors, primary=False):
        return (f'    <logicalmonitor>\n      <x>{x}</x>\n      <y>{y}</y>\n'
                f'      <scale>{scale}</scale>\n'
                + ('      <primary>yes</primary>\n' if primary else '')
                + monitors + '    </logicalmonitor>\n')

    SINGLE_LM = lm_xml(0, 0, "1.5", mon_xml("DP-1", "X", "DEL", "DELL U2720Q",
                                            3840, 2160, "59.997"), primary=True)
    OTHER_LM = lm_xml(1920, 0, "1.0", mon_xml("DP-2", "Y", "SAM", "SyncMaster",
                                              2560, 1440, "59.951"))
    STALE_LM = lm_xml(0, 0, "1.0", mon_xml("DP-1", "Z", "DEL", "DELL U2415",
                                           1920, 1080, "60.000"))
    # a cloned pair is a single <logicalmonitor> holding two <monitor> elements
    MIRROR_LM = lm_xml(0, 0, "1.0",
                       mon_xml("eDP-1", "L", "BOE", "0x095D", 2880, 1800, "60.000")
                       + mon_xml("DP-3", "M", "DEL", "U2720Q", 2880, 1800, "60.000"),
                       primary=True)
    SINGLE = doc(cfg_xml(SINGLE_LM))
    DUAL = doc(cfg_xml(SINGLE_LM + OTHER_LM), cfg_xml(STALE_LM))
    MIRROR = doc(cfg_xml(MIRROR_LM))

    # monitors.xml persistence, exercised against a scratch copy of the real format
    import tempfile
    global MONITORS_XML, MONITORS_XML_BACKUP
    _real_xml, _real_bak = MONITORS_XML, MONITORS_XML_BACKUP
    r = {}
    with tempfile.TemporaryDirectory() as td:
        MONITORS_XML = os.path.join(td, "monitors.xml")
        MONITORS_XML_BACKUP = MONITORS_XML + ".bak"
        with open(MONITORS_XML, "w") as fh:
            fh.write(SINGLE)
        running = dict(fake[0], current=("3840x2160@59.997", 3840, 2160, 59.997), scale=1.5,
                       specs=[("DP-1", "X")], identity=(("DP-1", "X"),))
        parsed = read_monitors_xml()
        r["parsed"] = len(parsed) == 1 and parsed[0]["monitors"][0]["scale"] == 1.5
        r["match_ok"] = stored_vs_running([running]) == []
        r["stale_detected"] = len(stored_vs_running([dict(running, scale=2.0)])) == 1
        err = persist_monitors_xml([running], {0: ("3840x2160@59.997", 2.0)})
        r["persist_ok"] = err is None
        r["backup_written"] = os.path.exists(MONITORS_XML_BACKUP)
        after = read_monitors_xml()
        r["scale_rewritten"] = bool(after) and after[0]["monitors"][0]["scale"] == 2.0
        r["stale_gone"] = stored_vs_running([dict(running, scale=2.0)]) == []
        other = persist_monitors_xml(
            [dict(fake[1], connectors=["DP-9"], specs=[("DP-9", "Y")],
                  identity=(("DP-9", "Y"),), primary=False)],
            {0: ("3840x2160@59.997", 2.0)})
        with open(MONITORS_XML) as fh:
            txt = fh.read()
        r["unknown_output_appended"] = other is None and "DP-9" in txt
        r["other_monitor_block_untouched"] = "<serial>X</serial>" in txt \
            and txt.count("<configuration>") == 2

        # two monitors running: the <configuration> that holds both is the one to update,
        # and the single-monitor block for a different panel has to stay as it was
        with open(MONITORS_XML, "w") as fh:
            fh.write(DUAL)
        dual_a = dict(running)
        dual_b = dict(fake[1], current=("2560x1440@59.951", 2560, 1440, 59.951), scale=1.0,
                      specs=[("DP-2", "Y")], identity=(("DP-2", "Y"),))
        dual = [dual_a, dual_b]
        r["dual_parsed"] = len(read_monitors_xml()) == 2
        r["dual_match_ok"] = stored_vs_running(dual) == []
        r["dual_stale_detected"] = len(stored_vs_running([dict(dual_a, scale=2.0),
                                                         dual_b])) == 1
        err = persist_monitors_xml(dual, {0: ("3840x2160@59.997", 2.0)})
        r["dual_persist_ok"] = err is None
        blocks = {tuple(sorted((m["connector"], m["serial"]) for m in c["monitors"])): c
                  for c in read_monitors_xml()}
        pair = blocks.get((("DP-1", "X"), ("DP-2", "Y")))
        lone = blocks.get((("DP-1", "Z"),))
        r["dual_scale_rewritten"] = bool(pair) and \
            [m["scale"] for m in pair["monitors"] if m["connector"] == "DP-1"] == [2.0]
        r["dual_untouched_keeps_current_mode"] = bool(pair) and \
            [m["mode"] for m in pair["monitors"] if m["connector"] == "DP-2"] == \
            [(2560, 1440, 59.951)]
        r["dual_other_block_untouched"] = bool(lone) and lone["monitors"][0]["mode"] == \
            (1920, 1080, 60.0) and lone["monitors"][0]["scale"] == 1.0
        r["dual_block_count"] = len(blocks) == 2
        r["dual_stale_gone"] = stored_vs_running([dict(dual_a, scale=2.0), dual_b]) == []

        # a mirrored pair is one <logicalmonitor> with two <monitor> elements
        with open(MONITORS_XML, "w") as fh:
            fh.write(MIRROR)
        cloned = dict(mirror, specs=[("eDP-1", "L"), ("DP-3", "M")],
                      identity=(("DP-3", "M"), ("eDP-1", "L")))
        parsed = read_monitors_xml()
        r["mirrored_both_monitors_parsed"] = len(parsed) == 1 and \
            len(parsed[0]["monitors"]) == 2
        r["mirrored_stale_detected"] = len(stored_vs_running([dict(cloned, scale=2.0)])) == 1
        err = persist_monitors_xml([cloned], {0: ("2880x1800@60", 2.0)})
        with open(MONITORS_XML) as fh:
            txt = fh.read()
        r["mirrored_persist_ok"] = err is None and txt.count("<logicalmonitor>") == 1 and \
            all(m["scale"] == 2.0 for m in read_monitors_xml()[0]["monitors"])

        # an untouched output with native=None must not crash, and the block that gets
        # appended must keep the real layout instead of stacking everything at 0,0
        with open(MONITORS_XML, "w") as fh:
            fh.write(SINGLE)
        err = persist_monitors_xml([running, no_native], {})
        with open(MONITORS_XML) as fh:
            txt = fh.read()
        blocks = {tuple(sorted((m["connector"], m["serial"]) for m in c["monitors"])): c
                  for c in read_monitors_xml()}
        added = blocks.get((("DP-1", "X"), ("DP-6", "")))
        r["untouched_without_native_persisted"] = err is None and bool(added)
        r["appended_block_keeps_layout"] = bool(added) and "<x>3840</x>" in txt and \
            [m["mode"] for m in added["monitors"] if m["connector"] == "DP-6"] == \
            [(1920, 1200, 59.95)]
        r["appended_block_keeps_running_scale"] = bool(added) and \
            [m["scale"] for m in added["monitors"] if m["connector"] == "DP-1"] == [1.5]

        # Mutter's 5/3 step has to survive being written and read back: %g-style rounding
        # to 1.66667 is a different scale and reads as stored-vs-running drift forever
        with open(MONITORS_XML, "w") as fh:
            fh.write(SINGLE)
        frac = dict(running, scale=FRAC)
        err = persist_monitors_xml([frac], {0: ("3840x2160@59.997", FRAC)})
        back = read_monitors_xml()
        r["fractional_scale_exact"] = err is None and bool(back) and \
            back[0]["monitors"][0]["scale"] == FRAC
        r["fractional_scale_no_drift"] = stored_vs_running([frac]) == []

        with open(MONITORS_XML, "w") as fh:
            fh.write("<monitors version='2'><configuration>")
        r["malformed_detected"] = False
        try:
            read_monitors_xml()
        except ValueError:
            r["malformed_detected"] = True
        r["malformed_not_edited"] = persist_monitors_xml(
            [running], {0: ("3840x2160@59.997", 2.0)}) is not None

        # a scratch fonts.conf has to be validated as itself, not against ~/.config
        good_fonts = os.path.join(td, "fonts-good.conf")
        bad_fonts = os.path.join(td, "fonts-bad.conf")
        with open(good_fonts, "w") as fh:
            fh.write(fontconf_body(*PROFILES["mac"][:2]))
        with open(bad_fonts, "w") as fh:
            fh.write('<fontconfig>\n  <match target="font"\n')
        have_fc = bool(shutil.which("fc-match"))
        r["fontconf_scratch_valid"] = (not have_fc) or fontconf_ok(good_fonts)[0]
        r["fontconf_scratch_malformed"] = (not have_fc) or (not fontconf_ok(bad_fonts)[0])
    MONITORS_XML, MONITORS_XML_BACKUP = _real_xml, _real_bak
    try:
        plan_fix([frac_panel], 5.0, 1920)
        r["forced_scale_rejected"] = False
    except ValueError as exc:
        r["forced_scale_rejected"] = "5.0" in str(exc) and str(FRAC) in str(exc) and \
            str(THIRDS) in str(exc)
    try:
        plan_fix([frac_panel], 1.75, 1920)
        r["whole_pixel_rejected"] = ""
    except ValueError as exc:
        r["whole_pixel_rejected"] = str(exc)
    try:
        plan_fix([frac_panel], 1.8, 1920)
        r["scale_18_rejected"] = ""
    except ValueError as exc:
        r["scale_18_rejected"] = str(exc)
    try:
        plan_fix([no_int_panel], 2.7, 1920)
        r["no_integer_step_rejected"] = False
    except ValueError as exc:
        r["no_integer_step_rejected"] = "2.7" in str(exc) and str(FRAC) in str(exc)

    # Hyprland: hyprctl JSON in, monitor= rules out, against scratch config files
    def hmon(name, desc, serial, x, scale, modes, w=3840, h=2160, rate=59.997, **kw):
        return dict({"name": name, "description": desc, "serial": serial, "width": w,
                     "height": h, "refreshRate": rate, "x": x, "y": 0, "scale": scale,
                     "transform": 0, "focused": False, "disabled": False, "mirrorOf": "none",
                     "availableModes": modes}, **kw)
    MODES_27 = ["3840x2160@60.00Hz", "3840x2160@29.56Hz", "2560x1440@59.95Hz"]
    MODES_32 = ["3840x2160@60.00Hz", "3840x2160@119.88Hz", "3840x2160@120.00Hz",
                "2560x1440@120.00Hz"]
    hj = [hmon("DP-2", "Dell Inc. DELL U2720Q AB12345", "AB12345", 0, 1.5, MODES_27),
          hmon("DP-3", "Dell Inc. DELL U3225QE CD67890", "CD67890", 2560, 1.5, MODES_32),
          hmon("HDMI-A-1", "Mirror", "", 0, 1.0, MODES_27, mirrorOf="DP-2"),
          hmon("DP-9", "Off", "", 0, 1.0, MODES_27, disabled=True)]
    hstates, hskipped = hypr_states_from_json(hj)
    hstates_2x = [dict(hstates[0], scale=2.0), dict(hstates[1], scale=2.0, x=1920)]
    xstates = [dict(hstates[0], id=0), dict(hstates[1], id=1, scale=1.2)]
    xclients = [{"class": "foot", "xwayland": False, "monitor": 1},
                {"class": "com.anthropic.Claude", "xwayland": True, "monitor": 0},
                {"class": "Google-chrome", "xwayland": True, "monitor": 1}]
    blurry = hypr_states_from_json([hmon("DP-1", "Dell Inc. DELL U2720Q X", "X", 0, 1.0,
                                         MODES_27, w=2560, h=1440, rate=59.951)])[0]
    h4k = hypr_scales(3840, 2160)
    r["h_layout"], _ = hypr_layout(hstates, {0: (3840, 2160, 2.0), 1: (3840, 2160, 2.0)})
    overlapping = [dict(hstates[0], x=1920), dict(hstates[1], x=0)]
    r["h_overlap"], _ = hypr_layout(overlapping, {0: (3840, 2160, 1.5), 1: (3840, 2160, 1.5)})
    stacked = [dict(hstates[0]), dict(hstates[1], x=0, y=1440)]
    r["h_stacked"], r["h_stacked_row"] = hypr_layout(
        stacked, {0: (3840, 2160, 2.0), 1: (3840, 2160, 2.0)})
    rotated = [dict(hstates[0], transform=1), dict(hstates[1], x=1440)]
    r["h_rotated"], _ = hypr_layout(rotated, {0: (3840, 2160, 2.0), 1: (3840, 2160, 2.0)})
    with tempfile.TemporaryDirectory() as td:
        conf = os.path.join(td, "hyprland.conf")
        mons = os.path.join(td, "monitors.conf")
        with open(mons, "w") as fh:
            fh.write("# Generated by nwg-displays\n\n"
                     "monitor=DP-3,3840x2160@60.0,0x150,1.5,bitdepth,10  # the 32\n"
                     "monitor=DP-2,3840x2160@60.0,1920x150,1.5\n")
        with open(conf, "w") as fh:
            fh.write("monitor = , preferred, auto, auto\n"
                     "# source = " + mons + "\n"
                     "decoration {\n  col = rgba(00000088) ## not a comment\n}\n")
        files = hypr_config_files(conf)
        notes = hypr_drift(hstates, files, td)
        r["h_unsourced_flagged"] = any("monitors.conf" in n and "nothing sources" in n
                                       for n in notes)
        r["h_catchall_flagged"] = sum("catch-all" in n for n in notes) == 2
        with open(conf, "w") as fh:
            fh.write("monitor = , preferred, auto, auto\nsource = ./monitors.conf\n")
        files = hypr_config_files(conf)
        r["h_source_followed"] = [os.path.basename(f) for f in files] == \
            ["hyprland.conf", "monitors.conf"]
        notes = hypr_drift(hstates, files, td)
        r["h_sourced_no_unsourced_note"] = not any("nothing sources" in n for n in notes)
        r["h_stale_position_ok"] = not any("catch-all" in n for n in notes)
        changes = plan_fix(hstates, None, 1920)[0]
        targets, positions, todo = hypr_targets(hstates, changes)
        r["h_todo"] = sorted(todo) == [0, 1]
        cmds = hypr_commands(hstates, targets, positions, todo, hypr_rules(files))
        r["h_cmds"] = cmds
        rendered = hypr_render(hstates, targets, positions, files)
        r["h_render_one_file"] = list(rendered) == [mons]
        err, written = hypr_write(rendered)
        with open(mons) as fh:
            txt = fh.read()
        r["h_written"] = err is None and written == [mons] and \
            os.path.exists(mons + HYPR_BACKUP_SUFFIX)
        r["h_extras_and_comment_kept"] = \
            "monitor=DP-3,3840x2160@59.997,1920x0,2,bitdepth,10  # the 32\n" in txt
        r["h_prefix_kept"] = "monitor=DP-2,3840x2160@59.997,0x0,2\n" in txt
        r["h_header_kept"] = txt.startswith("# Generated by nwg-displays\n")
        applied = [dict(s, scale=2.0, x=positions[i][0]) for i, s in enumerate(hstates)]
        r["h_no_drift_after_write"] = hypr_drift(applied, files, td) == []
        r["h_drift_detected"] = any("stores" in n for n in hypr_drift(hstates, files, td))
        # an output with no rule of its own gets one, by desc: so a reused connector name
        # cannot pick it up
        with open(mons, "w") as fh:
            fh.write("monitor=DP-3,3840x2160@60.0,1920x0,2\n")
        rendered = hypr_render(applied, targets, positions, files)
        r["h_appended_by_desc"] = mons in rendered and \
            "monitor = desc:Dell Inc. DELL U2720Q AB12345,3840x2160@59.997,0x0,2\n" in \
            rendered[mons]
        r["h_desc_rule_matches"] = hypr_rule_matches(
            {"fields": ["desc:Dell Inc. DELL U2720Q"]}, hstates[0]) and not \
            hypr_rule_matches({"fields": ["desc:Dell Inc. DELL U2720Q"]}, hstates[1])
    try:
        plan_fix(hstates, 1.8, 1920)
        r["h_18_rejected"] = False
    except ValueError as exc:
        r["h_18_rejected"] = "whole pixels" in str(exc)

    hypr_checks = [
        ("hypr: 4K offers 1.5, 5/3 and 2 on the 1/120 grid",
         1.5 in h4k and 2.0 in h4k and 200 / 120 in h4k),
        ("hypr: 4K refuses 1.75 and 1.8", 1.75 not in h4k and 1.8 not in h4k),
        ("hypr: rounded hyprctl scale snaps back onto the grid",
         hypr_snap(1.67) == 200 / 120 and hypr_snap(1.5) == 1.5 and hypr_snap(2) == 2.0),
        ("hypr: mode strings parse", hypr_parse_mode("3840x2160@60.00Hz") ==
         (3840, 2160, 60.0) and hypr_parse_mode("preferred") is None),
        ("hypr: mirrored and disabled outputs left alone",
         [s["name"] for s in hstates] == ["DP-2", "DP-3"] and len(hskipped) == 1),
        ("hypr: native is the largest mode, kernel-preferred refresh",
         hstates[1]["native"][:3] == ("3840x2160@60", 3840, 2160)),
        ("hypr: identity carries the serial", hstates[0]["identity"] == (("DP-2", "AB12345"),)),
        ("hypr: detects a 1440p signal on a 4K panel", len(find_problems(blurry)) == 1),
        ("hypr: plan picks 2x and keeps the running refresh",
         plan_fix(hstates, None, 1920)[0] ==
         {0: ("3840x2160@59.997", 2.0), 1: ("3840x2160@59.997", 2.0)}),
        ("hypr: plan switches a 1440p signal to native",
         plan_fix(blurry, None, 1920)[0] == {0: ("3840x2160@60", 2.0)}),
        ("hypr: plan refuses 1.8", r["h_18_rejected"]),
        ("hypr: plan snaps --scale 1.67 to 5/3",
         plan_fix(hstates, 1.67, 1920)[0][0][1] == 200 / 120),
        ("hypr: --scale 1.5 is taken as is",
         plan_fix(hstates_2x, 1.5, 1920)[0] ==
         {0: ("3840x2160@59.997", 1.5), 1: ("3840x2160@59.997", 1.5)}),
        ("hypr: --scale 1.6 is Hyprland's exact 1.6 step, not 5/3",
         plan_fix(hstates, 1.6, 1920)[0][0][1] == 1.6),
        ("hypr: --scale 1.5 from 2x re-packs the row to 2560 wide",
         hypr_targets(hstates_2x, plan_fix(hstates_2x, 1.5, 1920)[0])[1] ==
         {0: (0, 0), 1: (2560, 0)}),
        ("hypr: XWayland window on a scaled output is flagged",
         hypr_stretched_x11(xclients, xstates, False) ==
         [("com.anthropic.Claude", "DP-2", 1.5), ("Google-chrome", "DP-3", 1.2)]),
        ("hypr: native Wayland windows and 1x outputs are not flagged",
         hypr_stretched_x11([c for c in xclients if c["class"] != "Google-chrome"],
                            [xstates[0], dict(xstates[1], scale=1.0)], False) ==
         [("com.anthropic.Claude", "DP-2", 1.5)]),
        ("hypr: nothing flagged with force_zero_scaling on",
         hypr_stretched_x11(xclients, xstates, True) == []),
        ("hypr: one entry per app and monitor", len(hypr_stretched_x11(
            xclients + [dict(xclients[1], title="second window")], xstates, False)) == 2),
        ("hypr: launcher env gaps found",
         launcher_env_gaps("WAYLAND_DISPLAY=wayland-1\nXDG_SESSION_TYPE=tty\n") ==
         ["XDG_SESSION_TYPE", "ELECTRON_OZONE_PLATFORM_HINT"]),
        ("hypr: complete launcher env has no gaps", launcher_env_gaps(
            "XDG_SESSION_TYPE=wayland\nELECTRON_OZONE_PLATFORM_HINT=auto\n") == []),
