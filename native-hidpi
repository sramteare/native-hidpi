#!/usr/bin/env python3
"""Check that a GNOME (Mutter) or Hyprland session drives a monitor at its native
resolution, and switch to native mode with an integer framebuffer scale.

The common failure this addresses: a 4K panel fed a 1440p signal. The monitor's own
scaler upsamples every pixel by a non-integer factor, so the whole desktop looks soft.
No font, fontconfig or antialiasing setting can recover that, and nothing reports it -
the resolution just "looks a bit blurry".
"""

import argparse
import glob
import itertools
import json
import math
import os
import re
import shutil
import subprocess
import sys
import time

# python3-gi is only needed to talk to Mutter; the Hyprland backend uses hyprctl.
try:
    import gi
    gi.require_version("Gio", "2.0")
    from gi.repository import Gio, GLib
    HAVE_GI = True
    MUTTER_ERRORS = (GLib.Error, RuntimeError)
except (ImportError, ValueError):
    Gio = GLib = None
    HAVE_GI = False
    MUTTER_ERRORS = (RuntimeError,)

DEST = "org.gnome.Mutter.DisplayConfig"
PATH = "/org/gnome/Mutter/DisplayConfig"
IFACE = "org.gnome.Mutter.DisplayConfig"
STATE_SIG = "(ua((ssss)a(siiddada{sv})a{sv})a(iiduba(ssss)a{sv})a{sv})"
APPLY_SIG = "(uua(iiduba(ssa{sv}))a{sv})"

# Mutter's method flags are documented inconsistently across versions (verify/persist
# as bitflags in some, verify/temporary/persistent in others), so this tool applies
# exactly one configuration and checks the result by reading it back, rather than
# trusting a separate verify step.
METHOD_PERSIST = 2

# Mutter reports and accepts scales as float32: 5/3 comes back as 1.6666666269302368, so
# two scales that mean the same thing never compare exactly.
SCALE_TOL = 1e-5

STATE_DIR = os.path.join(
    os.environ.get("XDG_STATE_HOME", os.path.expanduser("~/.local/state")), "native-hidpi"
)
STATE_FILE = os.path.join(STATE_DIR, "state.json")
FONTCONF = os.path.join(
    os.environ.get("XDG_CONFIG_HOME", os.path.expanduser("~/.config")),
    "fontconfig",
    "fonts.conf",
)
FONTCONF_BACKUP = FONTCONF + ".native-hidpi.bak"

UI_FONT_KEYS = [
    "font-name",
    "monospace-font-name",
    "document-font-name",
    "font-antialiasing",
    "font-hinting",
    "font-rendering",
    "text-scaling-factor",
]

# fontconfig rgba/hintstyle, gnome antialiasing/hinting
PROFILES = {
    "mac": ("none", "hintslight", "grayscale", "slight"),
    "sharp": ("none", "hintfull", "grayscale", "full"),
    "subpixel": ("rgb", "hintslight", "rgba", "slight"),
}

# FreeType stem darkening: thickens thin strokes at small sizes, which is most of what makes
# macOS text look heavier and smoother than Linux's at the same size. It is not a fontconfig
# setting but a FreeType property read from the environment, so it has to reach every app:
# environment.d for the systemd user session (launcher-started apps, next login), the live
# session (set-environment), and on Hyprland an `env =` line for apps Hyprland starts. It
# acts through the autofitter, i.e. with hintslight; hintfull uses the fonts' own bytecode
# hinting and gets none, so only the mac profile turns it on.
DARKEN_PROFILES = ("mac",)
FT_VAR = "FREETYPE_PROPERTIES"
FT_DARKEN_KEYS = ("cff:no-stem-darkening", "autofitter:no-stem-darkening")
ENVD_FILE = os.path.join(
    os.environ.get("XDG_CONFIG_HOME", os.path.expanduser("~/.config")),
    "environment.d",
    "90-native-hidpi.conf",
)


def bus_call(method, inb=None, outt=None):
    bus = Gio.bus_get_sync(Gio.BusType.SESSION, None)
    return bus.call_sync(
        DEST, PATH, IFACE, method, inb,
        GLib.VariantType.new(outt) if outt else None,
        Gio.DBusCallFlags.NONE, -1, None,
    )


def have_display_config():
    if not HAVE_GI:
        return False
    try:
        bus_call("GetCurrentState", None, STATE_SIG)
        return True
    except GLib.Error:
        return False


def session_type():
    return os.environ.get("XDG_SESSION_TYPE", "unknown")


def read_state():
    """(serial, logical_monitors). A logical monitor may mirror several connectors."""
    serial, monitors, logical, _props = bus_call("GetCurrentState", None, STATE_SIG)
    out = []
    for lm in logical:
        x, y, scale, transform, primary, members, _ = lm
        connectors = [m[0] for m in members]
        specs = [(m[0], m[3]) for m in members]
        native = current = None
        scales = []
        native_scales = []
        builtin = False
        for mon in monitors:
            if mon[0][0] not in connectors:
                continue
            builtin = builtin or bool(mon[2].get("is-builtin", False))
            for mode in mon[1]:
                mode_id, w, h, rate, _max, supported, mode_props = mode
                if "is-current" in mode_props:
                    current = (mode_id, w, h, rate)
                    scales = list(supported)
                if "is-preferred" in mode_props:
                    native = (mode_id, w, h, rate)
                    native_scales = list(supported)
        out.append(
            {
                "connectors": connectors,
                "specs": specs,
                "identity": tuple(sorted(specs)),
                "x": x,
                "y": y,
                "scale": float(scale),
                "transform": transform,
                "primary": primary,
                "current": current,
                "native": native,
                "scales": scales,
                "native_scales": native_scales,
                "builtin": builtin,
            }
        )
    return int(serial), out


def best_integer_scale(native, scales, want_logical_width=1920):
    """Largest integer scale that the mode actually offers and whose logical width
    still fits the wanted desktop. Falls back to the largest supported scale."""
    if native is None:
        return 1.0
    offered = [float(s) for s in scales]
    candidates = []
    for s in (4, 3, 2, 1):
        if native[1] // s < want_logical_width:
            continue
        if not offered or float(s) in offered:
            candidates.append(float(s))
    if candidates:
        return max(candidates)
    return max(offered) if offered else 1.0


def scale_matches(s, wanted):
    """True when `wanted` is how a person writes the float32 step `s`. Mutter's repeating
    thirds come back as 1.6666666269302368 or 2.6666667461395264, and people type 1.6,
    1.66 or 1.67 for them, so either rounding or truncation at one or two decimals counts.
    Truncation is only shorthand for a step that has no finite decimal form: 1.875 is
    typed as 1.875, so `1.8` must not land on it (Hyprland's 1/120 grid has 15/8)."""
    if round(s, 1) == wanted or round(s, 2) == wanted:
        return True
    from fractions import Fraction
    den = Fraction(s).limit_denominator(1000).denominator
    while den % 2 == 0:
        den //= 2
    while den % 5 == 0:
        den //= 5
    repeating = den > 1
    return repeating and (math.floor(s * 10) / 10 == wanted
                          or math.floor(s * 100) / 100 == wanted)


def resolve_scale(forced_scale, scales):
    """Snap --scale onto a scale the mode really offers. This only ever picks a real
    framebuffer scale: text-scaling-factor is not a display scale (it resizes GNOME/GTK
    text, not windows, not Chrome or Electron, not the layout grid), so an unsupported
    request is refused rather than faked. Mutter accepts a scale only when it divides the
    mode into whole pixels, and rejects everything else with InvalidArgs."""
    if forced_scale is None:
        return None
    wanted = float(forced_scale)
    offered = [float(s) for s in scales or []]
    if not offered:
        return wanted
    matches = [s for s in offered if abs(s - wanted) <= 0.02 or scale_matches(s, wanted)]
    if matches:
        return float(min(matches, key=lambda s: abs(s - wanted)))
    closest = min(offered, key=lambda s: abs(s - wanted))
    raise ValueError(
        f"scale {wanted} is not a framebuffer scale this mode offers: the compositor only "
        f"accepts scales that divide the mode into whole pixels (3840/1.8 = 2133.33 is one "
        f"such rejection; Mutter answers InvalidArgs, Hyprland silently picks a different "
        f"one). Closest available: {closest}; "
        f"supported: {', '.join(str(s) for s in offered)}. It is not faked with "
        f"text-scaling-factor, which only resizes GNOME text and leaves windows, Chrome and "
        f"Electron at the old scale - pass --text-scale yourself if that is what you want.")


def parse_scale_args(values, connectors):
    """Split --scale values into one optional default and per-connector scales."""
    default, per_output = None, {}
    known = list(connectors)
    for raw in values or []:
        text = str(raw).strip()
        conn, sep, number = text.partition("=")
        if sep:
            conn = conn.strip()
            if not conn:
                raise ValueError(f"--scale: empty connector name in {text!r}")
            if conn not in known:
                raise ValueError(
                    f"--scale: unknown connector {conn}; connected outputs: "
                    f"{', '.join(known) or '(none)'}")
            if conn in per_output:
                raise ValueError(f"--scale: connector {conn} given more than once")
        elif default is not None:
            raise ValueError(
                "--scale: only one bare scale is allowed; use CONNECTOR=NUMBER for a "
                "specific output")
        scale = number if sep else text
        try:
            scale = float(scale)
        except ValueError:
            raise ValueError(
                f"--scale: {text!r} is not a number; use --scale NUMBER or "
                "--scale CONNECTOR=NUMBER") from None
        if not math.isfinite(scale) or scale <= 0:
            raise ValueError(f"--scale: scale must be greater than 0 (got {text!r})")
        if sep:
            per_output[conn] = scale
        else:
            default = scale
    return default, per_output


def build_apply_list(states, changes):
    """The logical_monitors array is the complete desired configuration: anything left
    out is disabled. Always send every output, changing only what was asked for."""
    lm = []
    for i, s in enumerate(states):
        mode_id, scale = changes.get(i, (s["current"][0] if s["current"] else None, s["scale"]))
        if mode_id is None:
            raise RuntimeError(f"{s['connectors']}: no current mode, refusing to apply")
        lm.append((s["x"], s["y"], float(scale), s["transform"], s["primary"],
                   [(conn, mode_id, {}) for conn in s["connectors"]]))
    return lm


def apply_changes(states, changes, dry=False):
    if dry:
        return
    serial, fresh = read_state()
    if len(fresh) != len(states):
        raise RuntimeError(
            f"output count changed between reading and applying "
            f"({len(states)} -> {len(fresh)}); nothing applied, re-run"
        )
    for i, s in enumerate(fresh):
        if sorted(s["connectors"]) != sorted(states[i]["connectors"]):
            raise RuntimeError("output set changed (hotplug?); nothing applied, re-run")
    args = GLib.Variant(APPLY_SIG, (serial, METHOD_PERSIST, build_apply_list(fresh, changes), {}))
    bus_call("ApplyMonitorsConfig", args)


def verify_applied(changes, retries=1):
    """Read the configuration back. This, not a verify flag, is the safety net."""
    for _ in range(retries + 1):
        _serial, states = read_state()
        bad = []
        for i, (mode_id, scale) in changes.items():
            if i >= len(states):
                bad.append(f"output {i} missing")
                continue
            s = states[i]
            if s["current"] is None or s["current"][0] != mode_id or \
                    abs(s["scale"] - scale) > SCALE_TOL:
                got = s["current"][0] if s["current"] else "none"
                bad.append(f"{','.join(s['connectors'])}: wanted {mode_id} scale {scale}, got {got} scale {s['scale']}")
        if not bad:
            return True, []
    return False, bad


def resolution_problem(cur, native):
    return bool(cur and native and (cur[1], cur[2]) != (native[1], native[2]))


def find_problems(states):
    """Non-native resolution on a panel, i.e. the monitor's scaler is in the path."""
    msgs = []
    for m in states:
        cur, native = m["current"], m["native"]
        if resolution_problem(cur, native):
            ratio = native[1] / cur[1]
            msgs.append(
                f"{','.join(m['connectors'])}: {cur[1]}x{cur[2]} signal on a "
                f"{native[1]}x{native[2]} panel, monitor upscales x{ratio:.2f}"
                + (" (built-in panel)" if m.get("builtin") else "")
            )
    return msgs


def find_notes(states):
    msgs = []
    for m in states:
        if not float(m["scale"]).is_integer():
            msgs.append(
                f"{','.join(m['connectors'])}: fractional scale {m['scale']} - clients that "
                "do not implement fractional-scale-v1 render at the next integer scale and "
                "get resampled, and apps that ignore scaling end up a different size than "
                "their neighbours"
            )
    return msgs


def report(states):
    for m in states:
        cur, native = m["current"], m["native"]
        label = ",".join(m["connectors"]) + (" [built-in]" if m["builtin"] else "")
        print(f"\n{label}  scale {m['scale']}  primary={m['primary']}")
        if cur is None:
            print("  no current mode reported")
            continue
        print(f"  active : {cur[0]}")
        print(f"  native : {native[0] if native else 'unknown'}")
        print(f"  scales supported on the active mode: "
              f"{', '.join(str(s) for s in m['scales']) if m['scales'] else 'unknown'}")
    problems = find_problems(states)
    for p in problems:
        print("\nWARNING  " + p +
              ". Everything on screen is soft and no font setting will fix it.")
    for n in find_notes(states):
        print("\nNOTE     " + n)
    return len(problems)


def gsettings_get(key):
    if not shutil.which("gsettings"):
        return None
    r = subprocess.run(
        ["gsettings", "get", "org.gnome.desktop.interface", key],
        capture_output=True, text=True,
    )
    return r.stdout.strip() if r.returncode == 0 else None


def gsettings_op(op, key, value=None):
    if not shutil.which("gsettings"):
        return False
    argv = ["gsettings", op, "org.gnome.desktop.interface", key]
    if op == "set":
        argv.append(value)
    return subprocess.run(argv, capture_output=True).returncode == 0


def gsettings_float(key, default=1.0):
    raw = gsettings_get(key)
    if raw is None:
        return default
    try:
        return float(raw.strip().strip("'"))
    except ValueError:
        return default


def fontconf_body(rgba, hintstyle):
    return f"""<?xml version="1.0"?>
<!DOCTYPE fontconfig SYSTEM "fonts.dtd">
<!-- written by native-hidpi -->
<fontconfig>
  <match target="font">
    <edit name="antialias" mode="assign"><bool>true</bool></edit>
    <edit name="rgba" mode="assign"><const>{rgba}</const></edit>
    <edit name="hinting" mode="assign"><bool>true</bool></edit>
    <edit name="hintstyle" mode="assign"><const>{hintstyle}</const></edit>
    <edit name="hintauto" mode="assign"><bool>false</bool></edit>
    <edit name="embeddedbitmap" mode="assign"><bool>false</bool></edit>
  </match>
</fontconfig>
"""


def fontconf_ok(path):
    """fontconfig drops the *entire* file on a single parse error and every client
    silently falls back to distro defaults. fontconfig always names the offending file
    in its message, so only attribute errors that mention ours."""
    if not shutil.which("fc-match"):
        return True, ""
    env = None
    if os.path.abspath(path) != os.path.abspath(FONTCONF):
        env = dict(os.environ, FONTCONFIG_FILE=path)
    err = subprocess.run(["fc-match", "sans-serif"], capture_output=True,
                         text=True, env=env).stderr
    return (os.path.basename(path) not in err and path not in err), err.strip()


def write_fontconf(rgba, hintstyle):
    import xml.etree.ElementTree as ET
    body = fontconf_body(rgba, hintstyle)
    try:
        ET.fromstring(body)
    except ET.ParseError as exc:
        sys.exit(f"refusing to write malformed fonts.conf: {exc}")
    if os.path.exists(FONTCONF) and not os.path.exists(FONTCONF_BACKUP):
        shutil.copy2(FONTCONF, FONTCONF_BACKUP)
    try:
        os.makedirs(os.path.dirname(FONTCONF), exist_ok=True)
        tmp = FONTCONF + ".tmp"
        with open(tmp, "w") as fh:
            fh.write(body)
        os.replace(tmp, FONTCONF)
    except OSError as exc:
        sys.exit(f"cannot write {FONTCONF}: {exc}")
    ok, err = fontconf_ok(FONTCONF)
    if not ok:
        if os.path.exists(FONTCONF_BACKUP):
            shutil.copy2(FONTCONF_BACKUP, FONTCONF)
        else:
            os.remove(FONTCONF)
        sys.exit(f"fontconfig rejected {FONTCONF}; previous file restored.\n{err}")
    return True


def ft_merge(existing, darken):
    """FREETYPE_PROPERTIES with stem darkening switched on (or our keys dropped), keeping
    any other property the user already sets there, e.g. truetype:interpreter-version."""
    props = [t for t in (existing or "").split()
             if t.split("=", 1)[0] not in FT_DARKEN_KEYS]
    if darken:
        props += [f"{k}=0" for k in FT_DARKEN_KEYS]
    return " ".join(props)


def ft_darkened(value):
    tokens = (value or "").split()
    return all(f"{k}=0" in tokens for k in FT_DARKEN_KEYS)


def envd_body(value):
    return ("# written by native-hidpi: FreeType stem darkening (thicker, macOS-like strokes\n"
            "# at small sizes). Read by systemd --user at login; `native-hidpi revert` removes it.\n"
            f'{FT_VAR}="{value}"\n')


def systemd_env_get(name):
    if not shutil.which("systemctl"):
        return None
    out = subprocess.run(["systemctl", "--user", "show-environment"], check=False,
                         capture_output=True, text=True).stdout
    for line in out.splitlines():
        k, _, v = line.partition("=")
        if k == name:
            if v.startswith("$'") and v.endswith("'"):
                v = v[2:-1]
            return v
    return None


def session_env_set(name, value):
    """Set (or with None, unset) a variable for apps started from here on: the systemd user
    manager and D-Bus activation. Returns False if systemctl refused."""
    ok = True
    if shutil.which("systemctl"):
        argv = (["systemctl", "--user", "set-environment", f"{name}={value}"]
                if value is not None else ["systemctl", "--user", "unset-environment", name])
        ok = subprocess.run(argv, check=False, capture_output=True).returncode == 0
    if shutil.which("dbus-update-activation-environment"):
        # D-Bus cannot unset; an empty FREETYPE_PROPERTIES is the same as none
        subprocess.run(["dbus-update-activation-environment", f"{name}={value or ''}"],
                       check=False, capture_output=True)
    return ok


def write_text_atomic(path, text):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = path + ".tmp"
    with open(tmp, "w") as fh:
        fh.write(text)
    os.replace(tmp, path)


def save_state(data):
    try:
        os.makedirs(STATE_DIR, exist_ok=True)
        tmp = STATE_FILE + ".tmp"
        with open(tmp, "w") as fh:
            json.dump(data, fh, indent=2)
        os.replace(tmp, STATE_FILE)
    except OSError as exc:
        sys.exit(f"cannot record previous state in {STATE_FILE}: {exc} (nothing applied)")


def load_state():
    if not os.path.exists(STATE_FILE):
        return {}
    try:
        with open(STATE_FILE) as fh:
            return json.load(fh)
    except (OSError, json.JSONDecodeError) as exc:
        print(f"{STATE_FILE} is unreadable ({exc}); keeping it aside and starting fresh")
        try:
            os.replace(STATE_FILE, STATE_FILE + ".corrupt")
        except OSError:
            pass
        return {}


MONITORS_XML = os.path.join(
    os.environ.get("XDG_CONFIG_HOME", os.path.expanduser("~/.config")), "monitors.xml"
)
MONITORS_XML_BACKUP = MONITORS_XML + ".native-hidpi.bak"


def identity_of(s):
    """(connector, serial) pairs of one logical monitor, mirrored ones included."""
    return tuple(s.get("identity") or tuple(sorted((c, "") for c in s["connectors"])))


def config_identity(states):
    """A <configuration> block in monitors.xml is the *whole* set of connected monitors,
    so a block is only comparable to the whole running set."""
    return tuple(sorted(spec for s in states for spec in identity_of(s)))


def mode_geometry(s, mode_id):
    """(w, h, rate) of the mode we are about to store. Use the mode that is actually
    being applied: an untouched output must keep its current mode, and with it its
    refresh rate, instead of being rewritten with the native one."""
    for src in (s.get("current"), s.get("native")):
        if src and src[0] == mode_id:
            return src[1], src[2], src[3]
    fallback = s.get("native") or s.get("current")
    return (fallback[1], fallback[2], fallback[3]) if fallback else (0, 0, 0.0)


def format_scale(scale):
    """Write the scale back exactly as Mutter reports it. Its fractional steps are float32
    values (5/3 reads back as 1.6666666269302368), and a %.6g-style truncation to 1.66667
    is a different scale that then looks like stored-vs-running drift forever."""
    scale = float(scale)
    return str(int(scale)) if scale.is_integer() else str(scale)


def read_monitors_xml():
    """Return the stored configurations as a list of dicts, or [] if there is no file.
    Raises ValueError if the file cannot be parsed."""
    if not os.path.exists(MONITORS_XML):
        return []
    import xml.etree.ElementTree as ET
    try:
        root = ET.parse(MONITORS_XML).getroot()
    except (ET.ParseError, OSError) as exc:
        raise ValueError(f"{MONITORS_XML}: {exc}")
    out = []
    for cfg in root.findall("configuration"):
        monitors = []
        for lm in cfg.findall("logicalmonitor"):
            scale_node = lm.find("scale")
            try:
                scale = float(scale_node.text) \
                    if scale_node is not None and scale_node.text else 1.0
            except (ET.ParseError, TypeError, ValueError) as exc:
                raise ValueError(f"{MONITORS_XML}: unreadable <scale>: {exc}")
            for mon in lm.findall("monitor"):
                spec = mon.find("monitorspec")
                mode = mon.find("mode")
                if spec is None or mode is None:
                    continue
                try:
                    entry = {
                        "element": lm,
                        "monitor_element": mon,
                        "connector": spec.findtext("connector"),
                        "product": spec.findtext("product"),
                        "serial": spec.findtext("serial") or "",
                        "mode": (int(mode.findtext("width")), int(mode.findtext("height")),
                                 float(mode.findtext("rate"))),
                        "scale": scale,
                    }
                except (ET.ParseError, TypeError, ValueError) as exc:
                    raise ValueError(f"{MONITORS_XML}: unreadable <mode>: {exc}")
                monitors.append(entry)
        if monitors:
            out.append({"element": cfg, "monitors": monitors})
    return out


def persist_monitors_xml(states, changes):
    """Mutter's persistent apply does not reliably rewrite ~/.config/monitors.xml, and
    whatever is in that file is what you get back after a hotplug or a login. So write
    it ourselves: update the stored block that matches the current outputs, or append a
    new one."""
    import xml.etree.ElementTree as ET

    try:
        root = ET.parse(MONITORS_XML).getroot() if os.path.exists(MONITORS_XML) else \
            ET.Element("monitors", {"version": "2"})
    except ET.ParseError:
        return f"{MONITORS_XML} is malformed; refusing to edit it"

    if os.path.exists(MONITORS_XML) and not os.path.exists(MONITORS_XML_BACKUP):
        try:
            shutil.copy2(MONITORS_XML, MONITORS_XML_BACKUP)
        except OSError as exc:
            return f"could not back up {MONITORS_XML}: {exc}"

    want = {}
    for i, s in enumerate(states):
        mode_id, scale = changes.get(i, (s["current"][0] if s["current"] else None, s["scale"]))
        if mode_id is None:
            continue
        w, h, rate = mode_geometry(s, mode_id)
        want[identity_of(s)] = (w, h, rate, float(scale), s["primary"])

    full = config_identity(states)

    updated = 0
    for cfg in root.findall("configuration"):
        block_id = tuple(sorted(
            (mon.findtext("monitorspec/connector"),
             mon.findtext("monitorspec/serial") or "")
            for l in cfg.findall("logicalmonitor")
            for mon in l.findall("monitor")
        ))
        if block_id != full:
            continue
        for lm in cfg.findall("logicalmonitor"):
            key = tuple(sorted(
                (mon.findtext("monitorspec/connector"),
                 mon.findtext("monitorspec/serial") or "")
                for mon in lm.findall("monitor")
            ))
            entry = want.get(key)
            if entry is None:
                continue
            w, h, rate, scale, _prim = entry
            for mon in lm.findall("monitor"):
                mode = mon.find("mode")
                if mode is None:
                    mode = ET.SubElement(mon, "mode")
                for tag, value in (("width", str(w)), ("height", str(h)),
                                   ("rate", f"{rate:.3f}")):
                    node = mode.find(tag)
                    if node is None:
                        node = ET.SubElement(mode, tag)
                    node.text = value
            scale_node = lm.find("scale")
            if scale_node is None:
                scale_node = ET.SubElement(lm, "scale")
            scale_node.text = format_scale(scale)
        updated += 1

    if not updated and want:
        cfg = ET.SubElement(root, "configuration")
        ET.SubElement(cfg, "layoutmode").text = "logical"
        for s in states:
            identity = identity_of(s)
            entry = want.get(identity)
            if entry is None:
                continue
            w, h, rate, scale, primary = entry
            lm = ET.SubElement(cfg, "logicalmonitor")
            ET.SubElement(lm, "x").text = str(s.get("x", 0))
            ET.SubElement(lm, "y").text = str(s.get("y", 0))
            ET.SubElement(lm, "scale").text = format_scale(scale)
            if primary:
                ET.SubElement(lm, "primary").text = "yes"
            for conn, _serial in identity:
                mon = ET.SubElement(lm, "monitor")
                spec = ET.SubElement(mon, "monitorspec")
                for tag in ("connector", "vendor", "product", "serial"):
                    ET.SubElement(spec, tag).text = ""
                spec.find("connector").text = conn
                spec.find("serial").text = _serial
                mode = ET.SubElement(mon, "mode")
                for tag, value in (("width", str(w)), ("height", str(h)),
                                   ("rate", f"{rate:.3f}")):
                    ET.SubElement(mode, tag).text = value

    try:
        tmp = MONITORS_XML + ".tmp"
        ET.ElementTree(root).write(tmp, encoding="unicode", xml_declaration=False)
        ET.parse(tmp)  # never leave a broken config behind
        os.replace(tmp, MONITORS_XML)
    except (OSError, ET.ParseError) as exc:
        try:
            os.remove(MONITORS_XML + ".tmp")
        except OSError:
            pass
        return f"could not persist {MONITORS_XML}: {exc}"
    return None


def stored_vs_running(states):
    """Catch the case that eats users' crispness silently: the stored config disagrees
    with what is running, so the next hotplug or login will undo a live change."""
    notes = []
    try:
        stored = read_monitors_xml()
    except ValueError as exc:
        return [str(exc)]
    full = config_identity(states)
    for cfg in stored:
        block_id = tuple(sorted((m["connector"], m["serial"]) for m in cfg["monitors"]))
        if block_id != full:
            continue
        by_lm = {}
        for m in cfg["monitors"]:
            by_lm.setdefault(id(m["element"]), []).append(m)
        for s in states:
            if s["current"] is None:
                continue
            identity = identity_of(s)
            for lms in by_lm.values():
                if tuple(sorted((m["connector"], m["serial"]) for m in lms)) != identity:
                    continue
                bad = next((m for m in lms if (m["mode"][0], m["mode"][1]) !=
                            (s["current"][1], s["current"][2])), None)
                if bad is None and abs(lms[0]["scale"] - s["scale"]) > SCALE_TOL:
                    bad = lms[0]
                if bad is not None:
                    notes.append(
                        f"{','.join(c for c, _ in identity)}: running "
                        f"{s['current'][1]}x{s['current'][2]} "
                        f"scale {s['scale']} but {MONITORS_XML} stores "
                        f"{bad['mode'][0]}x{bad['mode'][1]} scale {bad['scale']} - the next "
                        "hotplug or login will switch it back"
                    )
    return notes


# ---------------------------------------------------------------------------------------
# Hyprland
#
# Hyprland has no DisplayConfig: the live state comes from `hyprctl -j monitors`, a change
# is a `keyword monitor` rule, and what survives a reload, hotplug or login is whatever
# `monitor=` lines the *sourced* config files hold. A monitors.conf that nothing sources
# (nwg-displays writes one and leaves the `source =` line to you) is the Hyprland twin of
# a monitors.xml that Mutter never rewrote: the change looks applied and then is not.
# ---------------------------------------------------------------------------------------

HYPR_DIR = os.path.join(
    os.environ.get("XDG_CONFIG_HOME", os.path.expanduser("~/.config")), "hypr"
)
HYPR_CONF = os.path.join(HYPR_DIR, "hyprland.conf")
HYPR_BACKUP_SUFFIX = ".native-hidpi.bak"
HYPR_ADDED_COMMENT = "# added by native-hidpi"
HYPR_ADDED_ENV_COMMENT = HYPR_ADDED_COMMENT + ": FreeType stem darkening (macOS-like strokes)"
# Hyprland keeps scales on 1/120 steps (the fractional-scale-v1 denominator) and only
# one that divides the mode into whole logical pixels; anything else it swaps for a
# nearby scale with a notification, so the request is refused here instead.
HYPR_SCALE_DEN = 120
HYPR_SCALE_TOL = 1e-3
HYPR_SKIPPED = []  # outputs left alone on the last read (mirrors), for status
MODE_RE = re.compile(r"\s*(\d+)x(\d+)(?:@([\d.]+)(?:Hz)?)?\s*$")
MONITOR_RE = re.compile(r"^(\s*monitor\s*=\s*)(.*?)(\s*)$")
SOURCE_RE = re.compile(r"^\s*source\s*=\s*(.+?)\s*$")


def hypr_socket(env=None):
    env = os.environ if env is None else env
    sig = env.get("HYPRLAND_INSTANCE_SIGNATURE")
    if not sig:
        return None
    runtime = env.get("XDG_RUNTIME_DIR") or f"/run/user/{os.getuid()}"
    return os.path.join(runtime, "hypr", sig, ".socket.sock")


def is_hyprland(env=None):
    """HYPRLAND_INSTANCE_SIGNATURE alone is not proof: Hyprland configs import it into the
    systemd user manager, which outlives the session, so a later GNOME login on the same
    machine still carries it. Hyprland can leave the socket file behind as well, so the
    test is whether something still answers on it."""
    sock = hypr_socket(env)
    if not sock or not shutil.which("hyprctl"):
        return False
    import socket
    try:
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as conn:
            conn.settimeout(2)
            conn.connect(sock)
        return True
    except OSError:
        return False


def hyprctl(*argv):
    try:
        r = subprocess.run(["hyprctl", *argv], check=False, capture_output=True,
                           text=True, timeout=10)
    except (OSError, subprocess.TimeoutExpired) as exc:
        raise RuntimeError(f"hyprctl {' '.join(argv)}: {exc}")
    if r.returncode != 0:
        raise RuntimeError(f"hyprctl {' '.join(argv)}: {(r.stderr or r.stdout).strip()}")
    return r.stdout


def hypr_scales(w, h, lo=1.0, hi=4.0):
    """Every 1/120 step that divides w x h into whole logical pixels."""
    return [k / HYPR_SCALE_DEN
            for k in range(int(lo * HYPR_SCALE_DEN), int(hi * HYPR_SCALE_DEN) + 1)
            if (w * HYPR_SCALE_DEN) % k == 0 and (h * HYPR_SCALE_DEN) % k == 0]


def hypr_snap(scale):
    """hyprctl prints scales rounded; put them back on the 1/120 grid they live on."""
    k = round(float(scale) * HYPR_SCALE_DEN)
    return k / HYPR_SCALE_DEN if k and abs(k / HYPR_SCALE_DEN - scale) < 0.005 else float(scale)


def hypr_parse_mode(text):
    """'3840x2160@60.00Hz' / '3840x2160@59.997' / '3840x2160' -> (w, h, rate)."""
    m = MODE_RE.match(text or "")
    if not m:
        return None
    return int(m.group(1)), int(m.group(2)), float(m.group(3) or 0.0)


def hypr_mode(w, h, rate):
    """Mode tuple in the shape the shared logic uses; the id is a valid rule resolution."""
    r = f"{float(rate):.3f}".rstrip("0").rstrip(".")
    return (f"{w}x{h}@{r}", int(w), int(h), float(rate))


def logical_size(w, h, scale, transform=0):
    if int(transform) % 2:  # 90/270, flipped or not
        w, h = h, w
    return w / scale, h / scale


def hypr_states_from_json(monitors):
    """Turn `hyprctl -j monitors all` into the state dicts the shared logic works on."""
    out, skipped = [], []
    for m in monitors:
        name = m.get("name", "?")
        if m.get("disabled"):
            continue
        if m.get("mirrorOf") not in (None, "", "none"):
            skipped.append(f"{name} mirrors {m['mirrorOf']}; left alone")
            continue
        cur = hypr_mode(m["width"], m["height"], m.get("refreshRate", 0.0))
        modes = [p for p in (hypr_parse_mode(t) for t in m.get("availableModes", [])) if p]
        # Hyprland marks no preferred mode, but the list is the kernel's, which puts the
        # preferred mode first: the first entry with the largest area is the panel's own.
        best = max(modes, key=lambda p: p[0] * p[1]) if modes else None
        native = hypr_mode(*best) if best else None
        serial = m.get("serial") or ""
        out.append({
            "connectors": [name],
            "specs": [(name, serial)],
            "identity": ((name, serial),),
            "name": name,
            "description": m.get("description") or "",
            "x": int(m.get("x", 0)),
            "y": int(m.get("y", 0)),
            "scale": hypr_snap(float(m.get("scale", 1.0))),
            "transform": int(m.get("transform", 0)),
            "primary": bool(m.get("focused")),
            "current": cur,
            "native": native,
            "scales": hypr_scales(cur[1], cur[2]),
            "native_scales": hypr_scales(native[1], native[2]) if native else [],
            "builtin": name.startswith(("eDP", "LVDS", "DSI")),
            "id": m.get("id"),
        })
    return out, skipped


def hypr_read_state():
    global HYPR_SKIPPED
    try:
        data = json.loads(hyprctl("-j", "monitors", "all"))
    except json.JSONDecodeError as exc:
        raise RuntimeError(f"hyprctl returned unreadable JSON: {exc}")
    states, HYPR_SKIPPED = hypr_states_from_json(data)
    return 0, states


def hypr_strip_comment(line):
    """Split a config line into (body, comment). '##' is Hyprland's escaped '#'."""
    i = 0
    while i < len(line):
        if line[i] == "#":
            if line[i + 1:i + 2] == "#":
                i += 2
                continue
            return line[:i], line[i:]
        i += 1
    return line, ""


def hypr_config_files(path=None, _seen=None):
    """hyprland.conf and everything it sources, in the order Hyprland reads them."""
    path = path or HYPR_CONF
    seen = [] if _seen is None else _seen
    if not os.path.isfile(path) or \
            os.path.realpath(path) in {os.path.realpath(p) for p in seen}:
        return seen
    seen.append(path)
    try:
        with open(path) as fh:
            lines = fh.read().splitlines()
    except OSError:
        return seen
    for line in lines:
        m = SOURCE_RE.match(hypr_strip_comment(line)[0])
        if not m:
            continue
        target = os.path.expandvars(os.path.expanduser(m.group(1)))
        if not os.path.isabs(target):
            target = os.path.join(os.path.dirname(path), target)
        target = os.path.normpath(target)
        for t in sorted(glob.glob(target)) or [target]:
            hypr_config_files(t, seen)
    return seen


def hypr_rules(files):
    """Every `monitor =` line (not monitorv2 blocks) with where it lives."""
    rules = []
    for path in files:
        try:
            with open(path) as fh:
                lines = fh.read().splitlines()
        except OSError:
            continue
        for n, line in enumerate(lines):
            body, comment = hypr_strip_comment(line)
            m = MONITOR_RE.match(body)
            if not m:
                continue
            rules.append({"path": path, "line": n, "raw": line, "prefix": m.group(1),
                          "trail": m.group(3), "comment": comment,
                          "fields": [f.strip() for f in m.group(2).split(",")]})
    return rules


def hypr_rule_kind(rule):
    f = rule["fields"]
    if len(f) > 1 and f[1].lower() in ("disable", "disabled"):
        return "disable"
    if len(f) > 1 and f[1].lower() == "addreserved":
        return "reserved"
    return "mode" if len(f) >= 4 else "other"


def hypr_rule_matches(rule, s):
    sel = rule["fields"][0]
    if sel.startswith("desc:"):
        want = sel[5:].strip()
        return bool(want) and s.get("description", "").startswith(want)
    return bool(sel) and sel == s["name"]


def hypr_own_rules(rules, s):
    """Rules naming this output (by connector or desc:); the last one is what applies."""
    return [r for r in rules if hypr_rule_kind(r) == "mode" and hypr_rule_matches(r, s)]


def hypr_rule_value(selector, mode_id, pos, scale, extras):
    return ",".join([selector, mode_id, f"{pos[0]}x{pos[1]}", format_scale(scale), *extras])


def hypr_extras(s, rules):
    """Keep transform/bitdepth/vrr/... that the user's own rule carries after the scale."""
    own = hypr_own_rules(rules, s)
    if own:
        return own[-1]["fields"][4:]
    return ["transform", str(s["transform"])] if s["transform"] else []


def merge_hypr_edits(recorded, edits):
    """Keep each edit's first old line; a later write only replaces its new line."""
    out = [dict(e) for e in recorded or []]
    for e in edits or []:
        key = (e.get("path"), e.get("kind"), e.get("key"))
        hit = next((x for x in out
                    if (x.get("path"), x.get("kind"), x.get("key")) == key), None)
        if hit:
            hit["new"] = e["new"]
        else:
            out.append(dict(e))
    return out


def hypr_record_edits(edits, prev=None):
    """Remember the lines we wrote, so revert can undo them without a whole-file backup."""
    if not edits:
        return
    own = prev is None
    prev = load_state() if own else prev
    prev["hypr_edits"] = merge_hypr_edits(prev.get("hypr_edits"), edits)
    if own:
        save_state(prev)


def hypr_undo_edits(text, edits):
    """Undo our own lines: remove what we added, restore what we replaced, note the rest."""
    lines, notes = text.splitlines(), []
    for e in edits or []:
        want = str(e.get("new") or "").rstrip()
        hit = next((i for i, line in enumerate(lines) if want and line.rstrip() == want), None)
        if hit is None:
            where = f"{e.get('path')}: " if e.get("path") else ""
            notes.append(f"{where}{e.get('key', '?')}: {e.get('kind', 'line')} line changed "
                         "since it was written; left alone")
            continue
        old = e.get("old")
        if old is not None:
            lines[hit] = old
            continue
        del lines[hit]
        if hit and lines[hit - 1].lstrip().startswith(HYPR_ADDED_COMMENT):
            del lines[hit - 1]
            if hit > 1 and not lines[hit - 2].strip():
                del lines[hit - 2]
    return "\n".join(lines) + ("\n" if text.endswith("\n") else ""), notes


def hypr_rule_disagrees(s, rules):
    """True when this output's own stored rule does not match what is running now."""
    own = hypr_own_rules(rules, s)
    if not own:
        return False
    f = own[-1]["fields"]
    res = hypr_parse_mode(f[1])
    try:
        stored_scale = hypr_snap(float(f[3]))
    except ValueError:
        stored_scale = None
    return ((res and (res[0], res[1]) != (s["current"][1], s["current"][2])) or
            (stored_scale is not None and abs(stored_scale - s["scale"]) > HYPR_SCALE_TOL))


def hypr_layout(states, targets, overlaps=None):
    """New logical positions. A row (or a single column) whose extents touch is re-packed
    in its current order; anything else keeps its positions. `overlaps` collects pairs of
    outputs whose resulting logical rectangles intersect. targets: i -> (w, h, scale)."""
    old = {i: logical_size(s["current"][1], s["current"][2], s["scale"], s["transform"])
           for i, s in enumerate(states)}
    by_x = sorted(range(len(states)), key=lambda i: (states[i]["x"], states[i]["y"]))
    by_y = sorted(range(len(states)), key=lambda i: (states[i]["y"], states[i]["x"]))
    row = all(states[a]["y"] < states[b]["y"] + old[b][1] and
              states[b]["y"] < states[a]["y"] + old[a][1]
              for a, b in itertools.pairwise(by_x))
    column = all(states[a]["x"] < states[b]["x"] + old[b][0] and
                 states[b]["x"] < states[a]["x"] + old[a][0]
                 for a, b in itertools.pairwise(by_y))
    if not row and not column:
        pos = {i: (s["x"], s["y"]) for i, s in enumerate(states)}
        packed = False
    else:
        order = by_x if row else by_y
        start = states[order[0]]["x" if row else "y"] if order else 0
        pos, at = {}, start
        for i in order:
            w, h, scale = targets[i]
            pos[i] = (round(at), states[i]["y"]) if row else (states[i]["x"], round(at))
            at += logical_size(w, h, scale, states[i]["transform"])[0 if row else 1]
        packed = True
    if overlaps is not None:
        overlaps.extend(hypr_find_overlaps(states, targets, pos))
    return pos, packed


def hypr_find_overlaps(states, targets, positions):
    """Pairs of outputs whose resulting logical rectangles intersect."""
    rects = {}
    for i, s in enumerate(states):
        w, h, scale = targets[i]
        lw, lh = logical_size(w, h, scale, s["transform"])
        rects[i] = (positions[i][0], positions[i][1], lw, lh)
    out = []
    for a, b in itertools.combinations(range(len(states)), 2):
        ax, ay, aw, ah = rects[a]
        bx, by, bw, bh = rects[b]
        if ax < bx + bw and bx < ax + aw and ay < by + bh and by < ay + ah:
            out.append((a, b))
    return out


def hypr_targets(states, changes, positions=None, overlaps=None):
    """(targets, positions, todo): what every output should run, where it goes, and the
    outputs that actually need a rule sent (changed, or moved by the re-layout)."""
    targets = {}
    for i, s in enumerate(states):
        mode_id, scale = changes.get(i, (s["current"][0], s["scale"]))
        w, h, _rate = hypr_parse_mode(mode_id)
        targets[i] = (mode_id, w, h, float(scale))
    if positions is None:
        packed, _ = hypr_layout(states, {i: t[1:] for i, t in targets.items()})
        positions = packed if changes else {i: (s["x"], s["y"]) for i, s in enumerate(states)}
    if overlaps is not None:
        overlaps.extend(hypr_find_overlaps(states, {i: t[1:] for i, t in targets.items()},
                                           positions))
    todo = [i for i in targets
            if i in changes or tuple(positions[i]) != (states[i]["x"], states[i]["y"])]
    return targets, positions, todo


def hypr_overlap_notes(states, overlaps):
    """Warning text for an arrangement Hyprland cannot re-pack on its own."""
    return [f"{','.join(states[a]['connectors'])} and {','.join(states[b]['connectors'])} "
            "overlap in the resulting layout; move one of them (for example with "
            "nwg-displays) so they do not cover each other"
            for a, b in overlaps]


def hypr_commands(states, targets, positions, todo, rules):
    return ["keyword monitor " + hypr_rule_value(
                states[i]["name"], targets[i][0], positions[i], targets[i][3],
                hypr_extras(states[i], rules))
            for i in todo]


def hypr_verify(want, retries=2):
    """want: name -> (w, h, rate, scale, (x, y)). Read back from hyprctl."""
    bad = []
    for attempt in range(retries + 1):
        if attempt:
            time.sleep(0.5)
        _serial, states = hypr_read_state()
        by_name = {s["name"]: s for s in states}
        bad = []
        for name, (w, h, rate, scale, pos) in want.items():
            s = by_name.get(name)
            if s is None:
                bad.append(f"{name}: missing after apply")
                continue
            c = s["current"]
            if (c[1], c[2]) != (w, h) or (rate and abs(c[3] - rate) > 0.5) or \
                    abs(s["scale"] - scale) > HYPR_SCALE_TOL or (s["x"], s["y"]) != tuple(pos):
                bad.append(f"{name}: wanted {w}x{h}@{rate:g} scale {format_scale(scale)} at "
                           f"{pos[0]}x{pos[1]}, got {c[0]} scale {format_scale(s['scale'])} "
                           f"at {s['x']}x{s['y']}")
        if not bad:
            return True, []
    return False, bad


def hypr_append_target(rules, files):
    """Where a rule for an output that has none goes: next to the other named rules."""
    for r in reversed(rules):
        if hypr_rule_kind(r) == "mode" and r["fields"][0]:
            return r["path"]
    for r in reversed(rules):
        return r["path"]
    return files[0] if files else HYPR_CONF


def hypr_render(states, targets, positions, files=None, todo=None, edits=None):
    """{path: new text} for the files whose rules change. Only outputs in `todo`, or with
    a stored rule that disagrees with what is running, are written. `edits` collects the
    lines to remember in state.json for a line-level revert."""
    files = files if files is not None else hypr_config_files()
    rules = hypr_rules(files)
    writable = (set(range(len(states))) if todo is None else set(todo)) | {
        i for i, s in enumerate(states) if hypr_rule_disagrees(s, rules)}
    lines_by_path, records = {}, []
    appends = []
    for i in sorted(writable):
        s = states[i]
        mode_id, _w, _h, scale = targets[i]
        own = [r for r in hypr_own_rules(rules, s)
               if sum(1 for t in states if hypr_rule_matches(r, t)) == 1]
        for r in own:
            line = r["prefix"] + hypr_rule_value(r["fields"][0], mode_id, positions[i], scale,
                                                 r["fields"][4:]) + r["trail"] + r["comment"]
            lines_by_path.setdefault(r["path"], {})[r["line"]] = line
            records.append({"path": r["path"], "kind": "rule", "key": r["fields"][0],
                            "old": r.get("raw"), "new": line})
        if not own:
            desc = s.get("description", "")
            unique = bool(desc) and "," not in desc and "#" not in desc and \
                sum(1 for t in states if t.get("description") == desc) == 1
            sel = f"desc:{desc}" if unique else s["name"]
            extras = ["transform", str(s["transform"])] if s["transform"] else []
            appends.append((sel, "monitor = " + hypr_rule_value(sel, mode_id, positions[i],
                                                                scale, extras)))
    out = {}
    target = hypr_append_target(rules, files)
    for path in set(lines_by_path) | ({target} if appends else set()):
        try:
            with open(path) as fh:
                text = fh.read()
        except FileNotFoundError:
            text = ""
        lines = text.splitlines()
        for n, line in lines_by_path.get(path, {}).items():
            lines[n] = line
        if path == target and appends:
            lines += ["", HYPR_ADDED_COMMENT] + [line for _sel, line in appends]
        new = "\n".join(lines) + "\n"
        if new != text:
            out[path] = new
    if edits is not None:
        for sel, line in appends:
            records.append({"path": target, "kind": "rule", "key": sel, "old": None,
                            "new": line})
        edits.extend(e for e in records if e["path"] in out)
    return out


def hypr_write(rendered):
    """Back up each file once, write atomically. Returns (error or None, paths written)."""
    written = []
    for path, text in rendered.items():
        backup = path + HYPR_BACKUP_SUFFIX
        try:
            if os.path.exists(path) and not os.path.exists(backup):
                shutil.copy2(path, backup)
            real = os.path.realpath(path)
            tmp = real + ".tmp"
            with open(tmp, "w") as fh:
                fh.write(text)
            os.replace(tmp, real)
            written.append(path)
        except OSError as exc:
            return f"could not write {path}: {exc}", written
    return None, written


def hypr_env_render(text, name, value):
    """hyprland.conf with `env = name,value` set: existing lines for it rewritten, else one
    added after the last `env =` line (or at the end)."""
    lines = text.splitlines()
    own = re.compile(rf"^\s*env\s*=\s*{re.escape(name)}\s*,")
    new = f"env = {name},{value}"
    hits = [i for i, line in enumerate(lines) if own.match(hypr_strip_comment(line)[0])]
    if hits:
        for i in hits:
            lines[i] = new
    else:
        envs = [i for i, line in enumerate(lines)
                if re.match(r"^\s*env\s*=", hypr_strip_comment(line)[0])]
        at = envs[-1] + 1 if envs else len(lines)
        lines[at:at] = [HYPR_ADDED_ENV_COMMENT, new]
    return "\n".join(lines) + "\n"


def hypr_env_edit(text, name, value):
    """The line-level record for setting `env = name,value` in hyprland.conf."""
    own = re.compile(rf"^\s*env\s*=\s*{re.escape(name)}\s*,")
    old = next((line for line in text.splitlines()
                if own.match(hypr_strip_comment(line)[0])), None)
    return {"path": HYPR_CONF, "kind": "env", "key": name, "old": old,
            "new": f"env = {name},{value}"}


def hypr_env_fallback_edit(text, name):
    """Recognise a tool-added env line from an older state.json with no edit record."""
    own = re.compile(rf"^\s*env\s*=\s*{re.escape(name)}\s*,")
    lines = text.splitlines()
    for i, line in enumerate(lines):
        if i and lines[i - 1].strip() == HYPR_ADDED_ENV_COMMENT and own.match(line):
            return {"path": HYPR_CONF, "kind": "env", "key": name, "old": None,
                    "new": line.rstrip()}
    return None


def hypr_env_unset(text, name, edits=None):
    """Undo our `env = name,...` line: remove it, or put the user's original line back."""
    own = [e for e in edits or [] if e.get("kind") == "env" and e.get("key") == name]
    if not own:
        fallback = hypr_env_fallback_edit(text, name)
        if fallback:
            own = [fallback]
    return hypr_undo_edits(text, own)


def hypr_env_original_value(prev, name):
    """The value of the user's own env line before we ever rewrote it, if there was one."""
    for e in prev.get("hypr_edits", []):
        if e.get("kind") != "env" or e.get("key") != name or e.get("old") is None:
            continue
        body, _comment = hypr_strip_comment(e["old"])
        m = re.match(rf"^\s*env\s*=\s*{re.escape(name)}\s*,\s*", body)
        if m:
            return body[m.end():].strip()
    return None


def freetype_restore_values(ft, prev, backend_name):
    """(systemd value, Hyprland live value) for undoing stem darkening. Only the latter
    comes from the user's original env line; systemd keeps the value it was given."""
    systemd = ft.get("session")
    live = systemd
    if backend_name == "hyprland":
        original = hypr_env_original_value(prev, FT_VAR)
        if original is not None:
            live = original
    return systemd, live


def hypr_drift(states, files=None, hypr_dir=None):
    """The ways a Hyprland config undoes a live change on the next reload or hotplug."""
    files = files if files is not None else hypr_config_files()
    hypr_dir = hypr_dir or HYPR_DIR
    rules = hypr_rules(files)
    notes = []
    for s in states:
        c = s["current"]
        own = hypr_own_rules(rules, s)
        if not own:
            fallback = [r for r in rules if hypr_rule_kind(r) == "mode" and not r["fields"][0]]
            if not fallback:
                notes.append(f"{s['name']}: no monitor rule at all - Hyprland picks mode and "
                             "scale itself on every reload or hotplug")
            elif fallback[-1]["fields"][3].lower() == "auto" or \
                    fallback[-1]["fields"][1].lower() in ("preferred", "highres", "highrr"):
                notes.append(f"{s['name']}: only the catch-all `monitor = "
                             f"{','.join(fallback[-1]['fields'])}` covers it, so Hyprland "
                             f"picks the scale itself on every reload or hotplug (running "
                             f"{format_scale(s['scale'])} now)")
            continue
        if hypr_rule_disagrees(s, rules):
            r = own[-1]
            f = r["fields"]
            notes.append(f"{s['name']}: running {c[1]}x{c[2]} scale {format_scale(s['scale'])} "
                         f"but {r['path']}:{r['line'] + 1} stores {f[1]} scale {f[3]} - the "
                         "next reload or hotplug will switch it back")
    sourced = {os.path.realpath(p) for p in files}
    for path in sorted(glob.glob(os.path.join(hypr_dir, "*.conf"))):
        if os.path.realpath(path) in sourced:
            continue
        theirs = [r for r in hypr_rules([path]) if hypr_rule_kind(r) == "mode"]
        hit = [s["name"] for s in states if any(hypr_rule_matches(r, s) for r in theirs)]
        if hit:
            notes.append(f"{path} has monitor rules for {', '.join(hit)} but nothing sources "
                         f"it from {files[0] if files else HYPR_CONF}, so they have no effect")
    return notes


# What a launcher-started app (systemd --user / D-Bus activation, not a child of Hyprland)
# needs to see to come up as a native Wayland client instead of on XWayland.
LAUNCHER_ENV = {"XDG_SESSION_TYPE": "wayland", "ELECTRON_OZONE_PLATFORM_HINT": None}


def hypr_stretched_x11(clients, states, zero_scaling):
    """[(class, monitor, scale)] for XWayland windows on a scaled output. Hyprland draws an
    X11 client at 1x and stretches it by the scale unless force_zero_scaling is on, so its
    text is resampled - the soft text people blame on fonts."""
    if zero_scaling:
        return []
    by_id = {s.get("id"): s for s in states}
    seen, out = set(), []
    for c in clients:
        mon = by_id.get(c.get("monitor"))
        if not c.get("xwayland") or mon is None or float(mon["scale"]) == 1.0:
            continue
        key = (c.get("class") or c.get("initialClass") or "?", mon["name"])
        if key not in seen:
            seen.add(key)
            out.append((key[0], mon["name"], mon["scale"]))
    return out


def launcher_env_gaps(env_text):
    """Names from LAUNCHER_ENV that `systemctl --user show-environment` lacks or has wrong."""
    have = {}
    for line in env_text.splitlines():
        k, _, v = line.partition("=")
        have[k] = v
    return [k for k, want in LAUNCHER_ENV.items()
            if k not in have or (want is not None and have[k] != want)]


def x11_advice(stretched, gaps):
    apps = ", ".join(f"{cls} on {mon} (scale {format_scale(sc)})" for cls, mon, sc in stretched)
    msg = (f"{apps} run under XWayland: Hyprland draws them at 1x and stretches them, so their "
           "text is resampled and no font or scale setting makes it crisp.")
    if gaps:
        msg += (f" The systemd user environment, which is all that apps started from a "
                f"launcher see, lacks {', '.join(gaps)}; export them at login, e.g. "
                f"`exec-once = dbus-update-activation-environment --systemd "
                f"{' '.join(LAUNCHER_ENV)} ...`, then restart those apps.")
    else:
        msg += (" The systemd user environment has the Wayland hints, but a launcher or shell "
                "that was already running still hands its apps the environment it started "
                "with: restart the launcher (or log out and in), then restart those apps.")
    if any("chrome" in cls.lower() or "chromium" in cls.lower() for cls, _m, _s in stretched):
        msg += (" If Chrome still comes up on X11 after that, set "
                "chrome://flags/#ozone-platform-hint to Wayland.")
    return msg


def hypr_x11_warnings(states):
    try:
        clients = json.loads(hyprctl("-j", "clients"))
        zero = re.search(r"int:\s*1", hyprctl("getoption", "xwayland:force_zero_scaling"))
    except (RuntimeError, json.JSONDecodeError):
        return []
    stretched = hypr_stretched_x11(clients, states, bool(zero))
    if not stretched:
        return []
    env = subprocess.run(["systemctl", "--user", "show-environment"], check=False,
                         capture_output=True, text=True).stdout if shutil.which("systemctl") else ""
    return [x11_advice(stretched, launcher_env_gaps(env))]


