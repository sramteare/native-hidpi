class MutterBackend:
    name = "mutter"
    label = "GNOME"
    state_key = "display"  # kept as-is so state.json from older versions still reverts
    own_keys = ("display", "monitors_xml_existed")
    atomic_apply = True
    errors = MUTTER_ERRORS
    escape = "Settings -> Displays"

    def available(self):
        if have_display_config():
            return None
        return (f"org.gnome.Mutter.DisplayConfig is not available (session type: "
                f"{session_type()}"
                + ("" if HAVE_GI else "; python3-gi is not installed: sudo apt install python3-gi")
                + "). This tool needs a GNOME session running Mutter, or Hyprland.")

    def read(self):
        return read_state()[1]

    def drift(self, states):
        return stored_vs_running(states)

    def extra_notes(self, states):
        return []

    def warnings(self, states):
        return []

    def session_env(self, name, value, persist=True):
        """GNOME's session reads the systemd user environment, so environment.d is enough."""

    def preview(self, states, changes):
        return [f"would persist to {MONITORS_XML} (backup {MONITORS_XML_BACKUP})"]

    def apply(self, states, changes):
        apply_changes(states, changes)
        return verify_applied(changes)

    def rollback(self, states):
        baseline = {i: (s["current"][0], s["scale"]) for i, s in enumerate(states) if s["current"]}
        apply_changes(states, baseline)
        return verify_applied(baseline)[0]

    def record(self, s):
        return {}

    def persist(self, states, changes):
        existed = os.path.exists(MONITORS_XML)
        err = persist_monitors_xml(states, changes)
        if err:
            return err
        prev = load_state()
        if "monitors_xml_existed" not in prev:
            prev["monitors_xml_existed"] = existed
            save_state(prev)
        print(f"persisted to {MONITORS_XML} (backup at {MONITORS_XML_BACKUP})")
        return None

    def restore_display(self, states, changes, saved_by_index):
        apply_changes(states, changes)
        return verify_applied(changes)

    def restore_config(self, prev, failed):
        if os.path.exists(MONITORS_XML_BACKUP):
            try:
                shutil.copy2(MONITORS_XML_BACKUP, MONITORS_XML)
                os.remove(MONITORS_XML_BACKUP)
                print(f"restored {MONITORS_XML} from {MONITORS_XML_BACKUP}")
            except OSError as exc:
                failed.append("monitors.xml")
                print(f"could not restore {MONITORS_XML}: {exc}")
        elif not prev.get("monitors_xml_existed", True) and os.path.exists(MONITORS_XML):
            try:
                os.remove(MONITORS_XML)
                print(f"removed {MONITORS_XML} (there was none before)")
            except OSError as exc:
                failed.append("monitors.xml")
                print(f"could not remove {MONITORS_XML}: {exc}")


class HyprlandBackend:
    name = "hyprland"
    label = "Hyprland"
    state_key = "hypr_display"
    own_keys = ("hypr_display", "hypr_files", "hypr_edits")
    atomic_apply = False  # a partial hyprctl --batch is possible
    errors = (RuntimeError,)
    escape = "fix the monitor= lines in your Hyprland config and run `hyprctl reload`"

    def __init__(self):
        self.positions = None

    def available(self):
        try:
            hyprctl("-j", "monitors")
            return None
        except RuntimeError as exc:
            return f"Hyprland is running but hyprctl cannot reach it: {exc}"

    def read(self):
        return hypr_read_state()[1]

    def drift(self, states):
        return hypr_drift(states)

    def extra_notes(self, states):
        return list(HYPR_SKIPPED)

    def warnings(self, states):
        return hypr_x11_warnings(states)

    def session_env(self, name, value, persist=True):
        """Apps Hyprland starts itself (keybinds, exec) inherit Hyprland's environment, not
        systemd's: set it live with `keyword env` and keep it with an `env =` line."""
        if persist:
            try:
                with open(HYPR_CONF) as fh:
                    text = fh.read()
            except OSError as exc:
                return f"could not read {HYPR_CONF}: {exc}"
            prev = load_state()
            env_edits = [e for e in prev.get("hypr_edits", [])
                         if e.get("path") == HYPR_CONF and e.get("kind") == "env"
                         and e.get("key") == name]
            if value:
                new = hypr_env_render(text, name, value)
                if new != text:
                    err, _ = hypr_write({HYPR_CONF: new})
                    if err:
                        return err
                    hypr_record_edits([hypr_env_edit(text, name, value)], prev)
                    recorded = prev.setdefault("hypr_files", [])
                    if HYPR_CONF not in recorded:
                        recorded.append(HYPR_CONF)
                    save_state(prev)
                    print(f"set `env = {name},...` in {HYPR_CONF} "
                          f"(backup at {HYPR_CONF + HYPR_BACKUP_SUFFIX})")
            else:
                new, notes = hypr_env_unset(text, name, env_edits)
                for note in notes:
                    print("NOTE     " + note)
                if new != text:
                    err, _ = hypr_write({HYPR_CONF: new})
                    if err:
                        return err
                    prev["hypr_edits"] = [e for e in prev.get("hypr_edits", [])
                                          if e not in env_edits]
                    save_state(prev)
                    print(f"removed `env = {name},...` line from {HYPR_CONF}")
        try:
            hyprctl("keyword", "env", f"{name},{value or ''}")
        except RuntimeError as exc:
            return f"`hyprctl keyword env` failed: {exc}"
        return None

    def preview(self, states, changes):
        files = hypr_config_files()
        targets, positions, todo = hypr_targets(states, changes)
        lines = ["would run: hyprctl " + c
                 for c in hypr_commands(states, targets, positions, todo, hypr_rules(files))]
        for path in hypr_render(states, targets, positions, files, todo):
            lines.append(f"would rewrite monitor rules in {path} "
                         f"(backup {path + HYPR_BACKUP_SUFFIX})")
        return lines

    def _send(self, states, changes, positions=None):
        _serial, fresh = hypr_read_state()
        if sorted(s["name"] for s in fresh) != sorted(s["name"] for s in states):
            raise RuntimeError("output set changed (hotplug?); nothing applied, re-run")
        targets, positions, todo = hypr_targets(states, changes, positions)
        cmds = hypr_commands(states, targets, positions, todo, hypr_rules(hypr_config_files()))
        if cmds:
            out = hyprctl("--batch", " ; ".join(cmds))
            replies = [l.strip() for l in out.splitlines() if l.strip()]
            if any(r != "ok" for r in replies):
                raise RuntimeError("hyprctl: " + "; ".join(replies))
        want = {}
        for i in todo:
            mode_id, w, h, scale = targets[i]
            want[states[i]["name"]] = (w, h, hypr_parse_mode(mode_id)[2], scale, positions[i])
        return targets, positions, want

    def apply(self, states, changes):
        _t, self.positions, want = self._send(states, changes)
        return hypr_verify(want)

    def rollback(self, states):
        original = {i: (s["x"], s["y"]) for i, s in enumerate(states)}
        # every output back to the mode, scale and position it had before
        baseline = {i: (s["current"][0], s["scale"]) for i, s in enumerate(states)}
        _t, _p, want = self._send(states, baseline, original)
        return hypr_verify(want)[0]

    def record(self, s):
        return {"x": s["x"], "y": s["y"]}

    def persist(self, states, changes):
        targets, positions, todo = hypr_targets(states, changes, self.positions)
        files = hypr_config_files()
        if not files:
            return f"{HYPR_CONF} does not exist; nothing to persist to"
        records = []
        rendered = hypr_render(states, targets, positions, files, todo, records)
        if not rendered:
            print("monitor rules in the Hyprland config already match")
            return None
        err, written = hypr_write(rendered)
        prev = load_state()
        recorded = prev.setdefault("hypr_files", [])
        for p in written:
            if p not in recorded:
                recorded.append(p)
        hypr_record_edits([e for e in records if e["path"] in written], prev)
        save_state(prev)
        if err:
            return err
        for p in written:
            print(f"persisted monitor rules to {p} (backup at {p + HYPR_BACKUP_SUFFIX})")
        # the file is now the truth; make Hyprland read it (autoreload may be off), and
        # check that what it reads back is what was asked for
        try:
            hyprctl("reload")
            time.sleep(0.5)
            errors = hyprctl("configerrors").strip()
            if errors:
                return f"Hyprland reports config errors after the reload:\n{errors}"
        except RuntimeError as exc:
            return f"rules written but `hyprctl reload` failed: {exc}"
        want = {states[i]["name"]: (t[1], t[2], hypr_parse_mode(t[0])[2], t[3], positions[i])
                for i, t in targets.items()}
        ok, bad = hypr_verify(want)
        if not ok:
            return ("rules written, but after `hyprctl reload` Hyprland runs something "
                    "else - another rule is overriding them:\n  " + "\n  ".join(bad))
        print("reloaded Hyprland from the config and read it back: matches")
        return None

    def restore_display(self, states, changes, saved_by_index):
        positions = {i: (saved_by_index[i].get("x", s["x"]), saved_by_index[i].get("y", s["y"]))
                     if i in saved_by_index else (s["x"], s["y"])
                     for i, s in enumerate(states)}
        _t, _p, want = self._send(states, changes, positions)
        return hypr_verify(want)

    def restore_config(self, prev, failed):
        backups = [p + HYPR_BACKUP_SUFFIX for p in prev.get("hypr_files", [])]
        if "hypr_edits" not in prev:
            if backups:
                print("note: this state has no line-level edit record, so Hyprland config "
                      "files were left alone")
                print("  compare them by hand with: " + ", ".join(backups))
            return
        by_path = {}
        for e in prev["hypr_edits"]:
            by_path.setdefault(e.get("path"), []).append(e)
        rendered, notes = {}, []
        for path, edits in by_path.items():
            try:
                with open(path) as fh:
                    text = fh.read()
            except OSError as exc:
                failed.append("hyprland config")
                print(f"could not read {path}: {exc}")
                continue
            new, path_notes = hypr_undo_edits(text, edits)
            notes.extend(path_notes)
            if new != text:
                rendered[path] = new
        for note in notes:
            print("NOTE     " + note)
        if rendered:
            err, written = hypr_write(rendered)
            if err:
                failed.append("hyprland config")
                print(f"could not restore Hyprland config lines: {err}")
            else:
                for path in written:
                    print(f"undid native-hidpi's lines in {path}")
        if backups:
            print("backups of the original config files were kept at: " + ", ".join(backups))
        if is_hyprland():
            try:
                hyprctl("reload")
            except RuntimeError as exc:
                print(f"note: `hyprctl reload` failed ({exc}); reload Hyprland yourself")


def get_backend(name=None):
    name = name or ("hyprland" if is_hyprland() else "mutter")
    return HyprlandBackend() if name == "hyprland" else MutterBackend()


def need_display():
    backend = get_backend()
    problem = backend.available()
    if problem:
        sys.exit(problem)
    return backend


def cmd_status(_args):
    backend = need_display()
    states = backend.read()
    if not states:
        sys.exit(
            f"no monitors reported by {backend.name} - no display connected, or the "
            "session is headless. Re-run with a monitor attached."
        )
    print(f"compositor: {backend.name}")
    problems = report(states)
    stretched = backend.warnings(states)
    for warning in stretched:
        print("\nWARNING  " + warning)
    for note in backend.extra_notes(states):
        print("\nNOTE     " + note)
    text_scale = gsettings_float("text-scaling-factor")
    font = gsettings_get("font-name")
    if font is not None:
        try:
            pt = float(font.strip("'").rsplit(" ", 1)[1])
            px_em = pt / 72 * 96 * states[0]["scale"] * text_scale
            extra = (f" x text-scaling-factor {text_scale:g} "
                     f"(effective {states[0]['scale'] * text_scale:g}x)"
                     if abs(text_scale - 1.0) > 1e-4 else "")
            print(f"\nUI font  {font.strip()}  -> {px_em:.1f} device px per em "
                  f"at scale {states[0]['scale']}{extra}")
        except (ValueError, IndexError):
            print(f"\nUI font  {font.strip()}  (no size set)")
        print(f"antialiasing {gsettings_get('font-antialiasing')}   "
              f"hinting {gsettings_get('font-hinting')}")
    ft = systemd_env_get(FT_VAR)
    if ft is None:
        ft = os.environ.get(FT_VAR)
    print(f"stem darkening {'on' if ft_darkened(ft) else 'off'}"
          + (f"   ({FT_VAR}={ft})" if ft else "")
          + ("" if ft_darkened(ft) else "   - `fix` (mac profile) turns it on"))
    broken = 0
    if os.path.exists(FONTCONF):
        ok, err = fontconf_ok(FONTCONF)
        if ok:
            print(f"\nuser fontconfig: {FONTCONF} loads ok")
        else:
            broken = 1
            print(f"\nWARNING  {FONTCONF} is malformed, so fontconfig has dropped it "
                  "entirely: Chrome, Electron and Java clients are silently back on "
                  "distro defaults.")
            print(f"  {err}")
    for note in backend.drift(states):
        print("\nNOTE     " + note)
    print("\n" + ("no non-native resolution detected" if problems == 0 else
                  f"{problems} monitor(s) not running at native resolution"))
    if stretched:
        print("some windows are stretched XWayland clients - see the WARNING above")
    return 0 if (problems == 0 and broken == 0 and not stretched) else 1


def plan_fix(states, forced_scale, want_logical_width, per_output=None):
    changes, skipped = {}, []
    for i, m in enumerate(states):
        if m["current"] is None:
            continue
        if m["native"] is None:
            skipped.append(",".join(m["connectors"]))
            continue
        needs_mode = resolution_problem(m["current"], m["native"])
        # switching to native: the scales the *native* mode offers are the ones Mutter
        # will accept; already native: keep the current mode, i.e. the user's refresh
        # rate, and only change the scale.
        target_mode = m["native"] if needs_mode else m["current"]
        target_scales = (m.get("native_scales") or m["scales"]) if needs_mode else m["scales"]
        if per_output:
            named = [c for c in m["connectors"] if c in per_output]
            given = {per_output[c] for c in named}
            if len(given) > 1:
                raise ValueError(f"{','.join(m['connectors'])}: conflicting per-output scales: "
                                 + ", ".join(f"{c}={per_output[c]}" for c in named))
            if named:
                try:
                    scale = resolve_scale(per_output[named[0]], target_scales)
                except ValueError as exc:
                    raise ValueError(f"{named[0]}: {exc}") from None
            elif forced_scale:
                scale = resolve_scale(forced_scale, target_scales)
            elif needs_mode and not any(
                    abs(float(s) - m["scale"]) <= SCALE_TOL for s in target_scales or []):
                scale = best_integer_scale(target_mode, target_scales, want_logical_width)
            else:
                scale = m["scale"]
        else:
            scale = (resolve_scale(forced_scale, target_scales) if forced_scale
                     else best_integer_scale(target_mode, target_scales, want_logical_width))
        needs_scale = abs(m["scale"] - scale) > SCALE_TOL
        if needs_mode or needs_scale:
            changes[i] = (target_mode[0], float(scale))
    return changes, skipped


def check_display_flags(args):
    """Flag combinations that cannot do what they say, checked before touching a display."""
    if args.no_display and args.no_fonts:
        return "--no-display and --no-fonts together leave nothing to do"
    if args.no_display and args.scale:
        return "--scale has no effect with --no-display; drop --no-display or --scale"
    return None


def apply_failure_text(backend, exc, rollback):
    """Mutter's apply is atomic; a Hyprland batch can be partial, so rollback is attempted."""
    if backend.atomic_apply:
        return f"apply failed, nothing changed: {exc}"
    try:
        rolled = rollback()
    except backend.errors as rb_exc:
        return (f"apply failed after a partial change: {exc}; previous configuration NOT "
                f"restored ({rb_exc}); {backend.escape}")
    return (f"apply failed after a partial change: {exc}; "
            + ("previous configuration restored" if rolled else
               f"previous configuration NOT restored; {backend.escape}"))


def cmd_fix(args):
    problem = check_display_flags(args)
    if problem:
        sys.exit(problem)
    backend = need_display()
    states = backend.read()
    if not states:
        sys.exit(
            f"no monitors reported by {backend.name} - no display connected, or the "
            "session is headless. Re-run with a monitor attached."
        )
    try:
        forced_scale, per_output = parse_scale_args(
            args.scale, [c for s in states for c in s["connectors"]])
    except ValueError as exc:
        sys.exit(str(exc))
    try:
        changes, skipped = plan_fix(states, forced_scale, args.want_logical_width, per_output)
    except ValueError as exc:
        sys.exit(str(exc))
    drift = backend.drift(states)
    if args.no_display:
        changes, skipped, drift = {}, [], []
    if backend.name == "hyprland":
        overlaps = []
        hypr_targets(states, changes, overlaps=overlaps)
        for note in hypr_overlap_notes(states, overlaps):
            print("WARNING  " + note)

    # text-scaling-factor is only ever set when it is asked for. --scale never borrows it:
    # shrinking the text does not shrink the desktop, so a scale the mode cannot do stays
    # refused. A leftover value from an earlier run is reset to 1.0 so it does not linger.
    target_text_scale = 1.0
    if args.text_scale is not None:
        if not 0.5 <= float(args.text_scale) <= 3.0:
            sys.exit(f"--text-scale must be between 0.5 and 3.0 (got {args.text_scale})")
        target_text_scale = float(args.text_scale)
    cur_text = gsettings_float("text-scaling-factor")
    stale = abs(cur_text - 1.0) > 1e-4

    if args.no_display:
        print("display left as it is (--no-display)")
    elif not changes:
        print("every output is already at native resolution with the chosen scale")
        if skipped:
            print(f"  (no native mode reported for: {', '.join(skipped)} - left alone)")
        for note in drift:
            print("NOTE     " + note)
    else:
        for i, (mode_id, scale) in changes.items():
            m = states[i]
            print(f"planned {','.join(m['connectors'])}: "
                  f"{m['current'][0]} scale {m['scale']} -> {mode_id} scale {scale}")
        print(f"(untouched outputs: {len(states) - len(changes)})")

    if args.dry_run:
        if changes or drift:
            for line in backend.preview(states, changes):
                print(line)
        if args.text_scale is not None or stale:
            print(f"would set text-scaling-factor={target_text_scale:g}"
                  + (f" (was {cur_text:g})" if args.text_scale is None and stale else ""))
        if not args.no_fonts:
            rgba, hintstyle, _ga, _gh = PROFILES[args.profile]
            print(f"would write {FONTCONF} (rgba={rgba}, hintstyle={hintstyle})")
            if args.profile in DARKEN_PROFILES:
                print(f"would turn on FreeType stem darkening: {ENVD_FILE}, the running "
                      "session" + (f", and `env =` in {HYPR_CONF}"
                                   if backend.name == "hyprland" else ""))
        return 0

    if changes:
        prev = load_state()
        if backend.state_key not in prev:
            prev[backend.state_key] = [
                dict({"connectors": s["connectors"], "specs": s.get("specs", []),
                      "mode": s["current"][0], "scale": s["scale"]}, **backend.record(s))
                for s in states if s["current"]
            ]
            save_state(prev)
        try:
            ok, bad = backend.apply(states, changes)
        except backend.errors as exc:
            sys.exit(apply_failure_text(backend, exc, lambda: backend.rollback(states)))
        if not ok:
            rolled = False
            try:
                rolled = backend.rollback(states)
            except backend.errors as exc:
                print(f"rollback failed too: {exc}")
            for line in bad:
                print("  " + line)
            sys.exit("the requested configuration did not take effect; "
                     + ("rolled back to the previous one." if rolled else
                        f"ROLL IT BACK YOURSELF: {backend.escape}"))
        for i, (mode_id, scale) in changes.items():
            print(f"applied {','.join(states[i]['connectors'])}: {mode_id} scale {scale} "
                  "(read back and confirmed)")

    # nothing to apply live, but the stored file still disagrees with what is running,
    # and that is what a hotplug or the next login would restore.
    if changes or drift:
        err = backend.persist(states, changes)
        if err:
            print(f"WARNING  {err}")
            print("  " + ("the live change is in effect, but the next hotplug or login "
                          "will undo it" if changes else
                          "nothing live needed changing, but the stored config is what the "
                          "next hotplug or login will restore"))

    if args.text_scale is not None or abs(target_text_scale - cur_text) > 1e-4:
        prev = load_state()
        if "interface" not in prev:
            prev["interface"] = {k: gsettings_get(k) for k in UI_FONT_KEYS}
            save_state(prev)
        if args.text_scale is not None:
            msg = f"set text-scaling-factor={target_text_scale:g}"
        else:
            msg = (f"reset text-scaling-factor to {target_text_scale:g} (was {cur_text:g}; "
                   "--scale never borrows text scaling in place of a framebuffer scale)")
        if gsettings_op("set", "text-scaling-factor", f"{target_text_scale:g}"):
            print(msg)
        else:
            print(f"WARNING  could not set text-scaling-factor={target_text_scale:g}")

    if not args.no_fonts:
        rgba, hintstyle, gnome_aa, gnome_hint = PROFILES[args.profile]
        prev = load_state()
        if "interface" not in prev:
            prev["interface"] = {k: gsettings_get(k) for k in UI_FONT_KEYS}
        if "fontconf" not in prev:
            if os.path.exists(FONTCONF):
                with open(FONTCONF) as fh:
                    prev["fontconf"] = fh.read()
            else:
                prev["fontconf"] = None
        save_state(prev)
        write_fontconf(rgba, hintstyle)
        gsettings_op("set", "font-rendering", "manual")
        gsettings_op("set", "font-antialiasing", gnome_aa)
        gsettings_op("set", "font-hinting", gnome_hint)
        print(f"wrote {FONTCONF} and set antialiasing={gnome_aa}, hinting={gnome_hint}")
        set_stem_darkening(backend, args.profile in DARKEN_PROFILES)
        print("profiles: mac (grayscale+slight+stem darkening), sharp (grayscale+full), "
              "subpixel (rgb+slight)")
        print("restart browsers and apps - they read fontconfig and FreeType settings once "
              "at startup")
    return 0


def set_stem_darkening(backend, on):
    """Switch FreeType stem darkening on (mac profile) or take our keys back out."""
    current = systemd_env_get(FT_VAR)
    if current is None:
        current = os.environ.get(FT_VAR, "")
    if not on and not ft_darkened(current) and not os.path.exists(ENVD_FILE):
        return
    prev = load_state()
    if "freetype" not in prev:
        envd = None
        if os.path.exists(ENVD_FILE):
            with open(ENVD_FILE) as fh:
                envd = fh.read()
        prev["freetype"] = {"envd": envd, "session": systemd_env_get(FT_VAR)}
        save_state(prev)
    value = ft_merge(current, on)
    try:
        if value:
            write_text_atomic(ENVD_FILE, envd_body(value))
        elif os.path.exists(ENVD_FILE):
            os.remove(ENVD_FILE)
    except OSError as exc:
        print(f"WARNING  could not write {ENVD_FILE}: {exc}")
    if not session_env_set(FT_VAR, value or None):
        print("WARNING  systemctl --user refused the environment change; it applies from "
              "the next login")
    err = backend.session_env(FT_VAR, value)
    if err:
        print(f"WARNING  {err}")
    if on:
        print(f"turned on FreeType stem darkening: {FT_VAR}=\"{value}\" in {ENVD_FILE} "
              "and the running session")
    else:
        print("turned FreeType stem darkening off again (not part of this profile)")


def cmd_revert(_args):
    prev = load_state()
    if not prev:
        print("nothing recorded in " + STATE_FILE)
        return 1
    failed = []

    # state.json can hold records from both compositors (the same machine run under GNOME
    # and under Hyprland); revert the one this session runs, keep the other's for later.
    backend = get_backend()
    other = get_backend("mutter" if backend.name == "hyprland" else "hyprland")
    # Hyprland: the restored files are what a reload applies, so put them back first and
    # then restore the recorded live state on top; Mutter: display first, then the file.
    if backend.name == "hyprland":
        backend.restore_config(prev, failed)

    if prev.get(backend.state_key):
        problem = backend.available()
        if problem:
            failed.append("display")
            print(f"cannot restore the display configuration: {problem}; "
                  f"{backend.escape} is the way back")
        else:
            states = backend.read()
            changes, saved_by_index = {}, {}
            for saved in prev[backend.state_key]:
                want_specs = saved.get("specs")
                for i, s in enumerate(states):
                    here = [tuple(c) for c in s.get("specs", [])]
                    if want_specs:
                        matched = sorted(here) == sorted(tuple(c) for c in want_specs)
                    else:  # state recorded before serials were tracked
                        matched = sorted(s["connectors"]) == sorted(saved["connectors"])
                    if matched:
                        changes[i] = (saved["mode"], saved["scale"])
                        saved_by_index[i] = saved
            if len(changes) != len(states):
                print("note: the connected output set no longer matches what was recorded; "
                      "restoring only the outputs that are present")
            if not states or not changes:
                failed.append("display")
                print("could not restore the display configuration: none of the recorded "
                      f"outputs are connected ({len(states)} reported); leaving "
                      f"{STATE_FILE} in place")
            else:
                try:
                    ok, bad = backend.restore_display(states, changes, saved_by_index)
                    if not ok:
                        failed.append("display")
                        print("the restored display configuration did not read back:")
                        for line in bad:
                            print("  " + line)
                    else:
                        print("restored " + ", ".join(
                            f"{','.join(s['connectors'])}={changes[i][0]}@{changes[i][1]}"
                            for i, s in enumerate(states) if i in changes))
                except backend.errors as exc:
                    failed.append("display")
                    print(f"could not restore the display configuration: {exc}")

    if backend.name != "hyprland":
        backend.restore_config(prev, failed)

    if "freetype" in prev:
        ft = prev["freetype"]
        try:
            if ft.get("envd") is None:
                if os.path.exists(ENVD_FILE):
                    os.remove(ENVD_FILE)
                    print(f"removed {ENVD_FILE}")
            else:
                write_text_atomic(ENVD_FILE, ft["envd"])
                print(f"restored {ENVD_FILE}")
        except OSError as exc:
            failed.append("environment.d")
            print(f"could not restore {ENVD_FILE}: {exc}")
        systemd, live = freetype_restore_values(ft, prev, backend.name)
        if not session_env_set(FT_VAR, systemd):
            failed.append("session environment")
        # hyprland.conf's own line was undone with the other config files above
        err = backend.session_env(FT_VAR, live or "", persist=False) \
            if backend.name == "hyprland" and is_hyprland() else None
        if err:
            print(f"note: {err}")

    if prev.get("interface"):
        for key, value in prev["interface"].items():
            if value is None:
                if not gsettings_op("reset", key):
                    failed.append("gsettings")
            elif not gsettings_op("set", key, value.strip("'")):
                failed.append("gsettings")

    if "fontconf" in prev:
        try:
            if prev["fontconf"] is None:
                if os.path.exists(FONTCONF):
                    os.remove(FONTCONF)
                print(f"removed {FONTCONF} (there was none before)")
            else:
                tmp = FONTCONF + ".tmp"
                with open(tmp, "w") as fh:
                    fh.write(prev["fontconf"])
                os.replace(tmp, FONTCONF)
                print(f"restored {FONTCONF}")
            if os.path.exists(FONTCONF_BACKUP):
                os.remove(FONTCONF_BACKUP)
        except OSError as exc:
            failed.append("fontconfig")
            print(f"could not restore {FONTCONF}: {exc}")

    if failed:
        print(f"\nnot reverted: {', '.join(sorted(set(failed)))}. Keeping {STATE_FILE} "
              "so you can try again.")
        return 1
    left = {k: prev[k] for k in other.own_keys if k in prev}
    if left:
        save_state(left)
        print(f"kept the {other.label} display record in {STATE_FILE}; run `revert` in a "
              f"{other.label} session to restore that one")
    else:
        try:
            os.remove(STATE_FILE)
        except OSError:
            pass
    print("reverted; restart browsers")
    return 0


def cmd_selftest(_args):
    """Exercise the decision logic without touching the display."""
    FRAC = 1.6666666269302368  # float32 5/3, exactly as Mutter reports it
    THIRDS = 1.3333333730697632  # float32 4/3
    EIGHTHS = 2.6666667461395264  # float32 8/3
    TEN_THIRDS = 3.3333332538604736  # float32 10/3
    STEPS4K = [1.0, 1.25, THIRDS, 1.5, FRAC, 2.0, 2.5, EIGHTHS, 3.0, TEN_THIRDS, 3.75, 4.0]
    fake = [
        {  # the bug this tool exists for: 1440p signal on a 4K panel
            "connectors": ["DP-1"], "x": 0, "y": 0, "scale": 1.0, "transform": 0,
            "primary": True, "current": ("2560x1440@59.951", 2560, 1440, 59.951),
            "native": ("3840x2160@59.997", 3840, 2160, 59.997),
            "scales": [1.0, 1.25, 1.5, 2.0], "builtin": False,
        },
        {  # correct: native mode, integer scale
            "connectors": ["DP-2"], "x": 1920, "y": 0, "scale": 2.0, "transform": 0,
            "primary": False, "current": ("3840x2160@59.997", 3840, 2160, 59.997),
            "native": ("3840x2160@59.997", 3840, 2160, 59.997),
            "scales": [1.0, 2.0], "builtin": False,
        },
    ]
    mirror = {  # a cloned pair is one logical monitor with two connectors
        "connectors": ["eDP-1", "DP-3"], "x": 0, "y": 0, "scale": 1.0, "transform": 1,
        "primary": True, "current": ("2880x1800@60", 2880, 1800, 60.0),
        "native": ("2880x1800@60", 2880, 1800, 60.0), "scales": [1.0, 2.0], "builtin": True,
    }
    stale = {  # native resolution but the panel's 60 Hz preferred mode is unused
        "connectors": ["DP-4"], "x": 0, "y": 0, "scale": 1.0, "transform": 0,
        "primary": False, "current": ("3840x2160@29.562", 3840, 2160, 29.562),
        "native": ("3840x2160@59.997", 3840, 2160, 59.997), "scales": [1.0, 2.0],
        "builtin": False,
    }
    # the current mode is 1080p and only offers 1x; the preferred (native) mode offers 2x
    low_res_scaled = {
        "connectors": ["DP-5"], "x": 0, "y": 0, "scale": 1.0, "transform": 0,
        "primary": True, "current": ("1920x1080@60", 1920, 1080, 60.0),
        "native": ("3840x2160@59.997", 3840, 2160, 59.997),
        "scales": [1.0], "native_scales": [1.0, 1.5, 2.0], "builtin": False,
    }
    no_native = {  # untouched output without a preferred mode must not break the write
        "connectors": ["DP-6"], "x": 3840, "y": 0, "scale": 1.0, "transform": 0,
        "primary": False, "current": ("1920x1200@59.95", 1920, 1200, 59.95),
        "native": None, "scales": [1.0], "builtin": False,
    }
    # 4K panel with the float32 steps a real Dell U2720Q reports. 1.75 and 1.8 are not
    # among them (3840/1.8 is not a whole pixel count), so those must be refused
    frac_panel = {
        "connectors": ["DP-7"], "x": 0, "y": 0, "scale": 1.0, "transform": 0,
        "primary": True, "current": ("2560x1440@59.951", 2560, 1440, 59.951),
        "native": ("3840x2160@59.997", 3840, 2160, 59.997),
        "scales": [1.0, 1.25, 1.5], "native_scales": STEPS4K,
        "builtin": False,
    }
    # the same panel on a cable that stops at 5/3: no integer step to fall back on
    no_int_panel = dict(frac_panel, connectors=["DP-8"],
                        native_scales=[1.0, 1.25, THIRDS, 1.5, FRAC])

    def cfg_xml(lms):
        return ('  <configuration>\n    <layoutmode>logical</layoutmode>\n' + lms
                + '  </configuration>\n')

    def doc(*cfgs):
        return '<monitors version="2">\n' + ''.join(cfgs) + '</monitors>\n'

    def mon_xml(conn, serial, vendor, product, w, h, rate):
        return (f'      <monitor>\n        <monitorspec>\n'
                f'          <connector>{conn}</connector>\n          <vendor>{vendor}</vendor>\n'
                f'          <product>{product}</product>\n          <serial>{serial}</serial>\n'
                f'        </monitorspec>\n        <mode>\n          <width>{w}</width>\n'
                f'          <height>{h}</height>\n          <rate>{rate}</rate>\n'
                f'        </mode>\n      </monitor>\n')

    def lm_xml(x, y, scale, monitors, primary=False):
        return (f'    <logicalmonitor>\n      <x>{x}</x>\n      <y>{y}</y>\n'
                f'      <scale>{scale}</scale>\n'
                + ('      <primary>yes</primary>\n' if primary else '')
                + monitors + '    </logicalmonitor>\n')

    SINGLE_LM = lm_xml(0, 0, "1.5", mon_xml("DP-1", "X", "DEL", "DELL U2720Q",
                                            3840, 2160, "59.997"), primary=True)
    OTHER_LM = lm_xml(1920, 0, "1.0", mon_xml("DP-2", "Y", "SAM", "SyncMaster",
                                              2560, 1440, "59.951"))
    STALE_LM = lm_xml(0, 0, "1.0", mon_xml("DP-1", "Z", "DEL", "DELL U2415",
                                           1920, 1080, "60.000"))
    # a cloned pair is a single <logicalmonitor> holding two <monitor> elements
    MIRROR_LM = lm_xml(0, 0, "1.0",
                       mon_xml("eDP-1", "L", "BOE", "0x095D", 2880, 1800, "60.000")
                       + mon_xml("DP-3", "M", "DEL", "U2720Q", 2880, 1800, "60.000"),
                       primary=True)
    SINGLE = doc(cfg_xml(SINGLE_LM))
    DUAL = doc(cfg_xml(SINGLE_LM + OTHER_LM), cfg_xml(STALE_LM))
    MIRROR = doc(cfg_xml(MIRROR_LM))

    # monitors.xml persistence, exercised against a scratch copy of the real format
    import tempfile
    global MONITORS_XML, MONITORS_XML_BACKUP
    _real_xml, _real_bak = MONITORS_XML, MONITORS_XML_BACKUP
    r = {}
    with tempfile.TemporaryDirectory() as td:
        MONITORS_XML = os.path.join(td, "monitors.xml")
        MONITORS_XML_BACKUP = MONITORS_XML + ".bak"
        with open(MONITORS_XML, "w") as fh:
            fh.write(SINGLE)
        running = dict(fake[0], current=("3840x2160@59.997", 3840, 2160, 59.997), scale=1.5,
                       specs=[("DP-1", "X")], identity=(("DP-1", "X"),))
        parsed = read_monitors_xml()
        r["parsed"] = len(parsed) == 1 and parsed[0]["monitors"][0]["scale"] == 1.5
        r["match_ok"] = stored_vs_running([running]) == []
        r["stale_detected"] = len(stored_vs_running([dict(running, scale=2.0)])) == 1
        err = persist_monitors_xml([running], {0: ("3840x2160@59.997", 2.0)})
        r["persist_ok"] = err is None
        r["backup_written"] = os.path.exists(MONITORS_XML_BACKUP)
        after = read_monitors_xml()
        r["scale_rewritten"] = bool(after) and after[0]["monitors"][0]["scale"] == 2.0
        r["stale_gone"] = stored_vs_running([dict(running, scale=2.0)]) == []
        other = persist_monitors_xml(
            [dict(fake[1], connectors=["DP-9"], specs=[("DP-9", "Y")],
                  identity=(("DP-9", "Y"),), primary=False)],
            {0: ("3840x2160@59.997", 2.0)})
        with open(MONITORS_XML) as fh:
            txt = fh.read()
        r["unknown_output_appended"] = other is None and "DP-9" in txt
        r["other_monitor_block_untouched"] = "<serial>X</serial>" in txt \
            and txt.count("<configuration>") == 2

        # two monitors running: the <configuration> that holds both is the one to update,
        # and the single-monitor block for a different panel has to stay as it was
        with open(MONITORS_XML, "w") as fh:
            fh.write(DUAL)
        dual_a = dict(running)
        dual_b = dict(fake[1], current=("2560x1440@59.951", 2560, 1440, 59.951), scale=1.0,
                      specs=[("DP-2", "Y")], identity=(("DP-2", "Y"),))
        dual = [dual_a, dual_b]
        r["dual_parsed"] = len(read_monitors_xml()) == 2
        r["dual_match_ok"] = stored_vs_running(dual) == []
        r["dual_stale_detected"] = len(stored_vs_running([dict(dual_a, scale=2.0),
                                                         dual_b])) == 1
        err = persist_monitors_xml(dual, {0: ("3840x2160@59.997", 2.0)})
        r["dual_persist_ok"] = err is None
        blocks = {tuple(sorted((m["connector"], m["serial"]) for m in c["monitors"])): c
                  for c in read_monitors_xml()}
        pair = blocks.get((("DP-1", "X"), ("DP-2", "Y")))
        lone = blocks.get((("DP-1", "Z"),))
        r["dual_scale_rewritten"] = bool(pair) and \
            [m["scale"] for m in pair["monitors"] if m["connector"] == "DP-1"] == [2.0]
        r["dual_untouched_keeps_current_mode"] = bool(pair) and \
            [m["mode"] for m in pair["monitors"] if m["connector"] == "DP-2"] == \
            [(2560, 1440, 59.951)]
        r["dual_other_block_untouched"] = bool(lone) and lone["monitors"][0]["mode"] == \
            (1920, 1080, 60.0) and lone["monitors"][0]["scale"] == 1.0
        r["dual_block_count"] = len(blocks) == 2
        r["dual_stale_gone"] = stored_vs_running([dict(dual_a, scale=2.0), dual_b]) == []

        # a mirrored pair is one <logicalmonitor> with two <monitor> elements
        with open(MONITORS_XML, "w") as fh:
            fh.write(MIRROR)
        cloned = dict(mirror, specs=[("eDP-1", "L"), ("DP-3", "M")],
                      identity=(("DP-3", "M"), ("eDP-1", "L")))
        parsed = read_monitors_xml()
        r["mirrored_both_monitors_parsed"] = len(parsed) == 1 and \
            len(parsed[0]["monitors"]) == 2
        r["mirrored_stale_detected"] = len(stored_vs_running([dict(cloned, scale=2.0)])) == 1
        err = persist_monitors_xml([cloned], {0: ("2880x1800@60", 2.0)})
        with open(MONITORS_XML) as fh:
            txt = fh.read()
        r["mirrored_persist_ok"] = err is None and txt.count("<logicalmonitor>") == 1 and \
            all(m["scale"] == 2.0 for m in read_monitors_xml()[0]["monitors"])

        # an untouched output with native=None must not crash, and the block that gets
        # appended must keep the real layout instead of stacking everything at 0,0
        with open(MONITORS_XML, "w") as fh:
            fh.write(SINGLE)
        err = persist_monitors_xml([running, no_native], {})
        with open(MONITORS_XML) as fh:
            txt = fh.read()
        blocks = {tuple(sorted((m["connector"], m["serial"]) for m in c["monitors"])): c
                  for c in read_monitors_xml()}
